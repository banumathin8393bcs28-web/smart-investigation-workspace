<%- include('../partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h1 class="mb-1"><i class="bi bi-person-lines-fill text-danger"></i> Criminal & Suspect Profiles</h1>
    <p class="text-muted fs-5 mb-0">Biometric profiles, aliases, risk evaluations, and case connections.</p>
  </div>
  <a href="/suspects/new" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Register New Suspect</a>
</div>

<!-- Search & Filter Bar -->
<div class="forensic-card p-3 mb-4">
  <form action="/suspects" method="GET" class="row g-2 align-items-center">
    <div class="col-md-5">
      <div class="input-group">
        <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
        <input 
          type="text" 
          class="form-control" 
          name="q" 
          placeholder="Search by Full Name, Alias, National ID, Phone..."
          value="<%= query.q || '' %>"
        >
      </div>
    </div>
    <div class="col-md-3">
      <select class="form-select" name="status">
        <option value="">All Statuses</option>
        <option value="Wanted" <%= query.status === 'Wanted' ? 'selected' : '' %>>Wanted</option>
        <option value="In Custody" <%= query.status === 'In Custody' ? 'selected' : '' %>>In Custody</option>
        <option value="Under Surveillance" <%= query.status === 'Under Surveillance' ? 'selected' : '' %>>Under Surveillance</option>
        <option value="Person of Interest" <%= query.status === 'Person of Interest' ? 'selected' : '' %>>Person of Interest</option>
        <option value="Cleared" <%= query.status === 'Cleared' ? 'selected' : '' %>>Cleared</option>
      </select>
    </div>
    <div class="col-md-3">
      <select class="form-select" name="riskLevel">
        <option value="">All Risk Levels</option>
        <option value="Extreme" <%= query.riskLevel === 'Extreme' ? 'selected' : '' %>>Extreme Risk</option>
        <option value="High" <%= query.riskLevel === 'High' ? 'selected' : '' %>>High Risk</option>
        <option value="Moderate" <%= query.riskLevel === 'Moderate' ? 'selected' : '' %>>Moderate Risk</option>
        <option value="Low" <%= query.riskLevel === 'Low' ? 'selected' : '' %>>Low Risk</option>
      </select>
    </div>
    <div class="col-md-1 d-grid">
      <button type="submit" class="btn btn-outline">Filter</button>
    </div>
  </form>
</div>

<!-- Suspects Cards Grid -->
<% if (suspects.length === 0) { %>
  <div class="forensic-card text-center py-5 text-muted">
    <i class="bi bi-person-x fs-1 mb-2 d-block"></i>
    <p class="fs-5">No suspect records found matching the given parameters.</p>
    <a href="/suspects/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Register New Profile</a>
  </div>
<% } else { %>
  <div class="row g-4">
    <% suspects.forEach(s => { %>
      <div class="col-md-6 col-lg-4">
        <div class="forensic-card h-100 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <img 
              src="<%= s.photo || '/images/default-suspect.png' %>" 
              alt="<%= s.fullName %>" 
              class="rounded border border-secondary"
              style="width: 76px; height: 76px; object-fit: cover;"
            >
            <div class="min-width-0 flex-grow-1">
              <h4 class="text-white mb-0 text-truncate"><%= s.fullName %></h4>
              <div class="text-info small fw-bold">Alias: "<%= s.alias || 'None' %>"</div>
              <div class="text-muted small">National ID: <%= s.nationalId || 'N/A' %></div>
            </div>
          </div>

          <div class="d-flex gap-2 mb-3">
            <span class="badge <%= s.riskLevel === 'Extreme' || s.riskLevel === 'High' ? 'badge-critical' : 'badge-open' %>">
              <%= s.riskLevel %> RISK
            </span>
            <span class="badge <%= s.status === 'Wanted' ? 'badge-tampered' : 'badge-open' %>">
              <%= s.status %>
            </span>
          </div>

          <div class="p-2 mb-3 rounded bg-dark border border-secondary-subtle text-secondary small flex-grow-1">
            <div><strong>Height:</strong> <%= s.physicalTraits?.height || 'N/A' %> | <strong>Eyes:</strong> <%= s.physicalTraits?.eyeColor || 'N/A' %></div>
            <div class="text-truncate"><strong>Marks:</strong> <%= s.physicalTraits?.identifyingMarks || 'None' %></div>
            <div><strong>Linked Cases:</strong> <%= (s.connectedCases || []).length %> Active</div>
          </div>

          <a href="/suspects/<%= s._id %>" class="btn btn-outline w-100 mt-auto">
            <i class="bi bi-file-person"></i> Open Dossier
          </a>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('../partials/footer') %>
