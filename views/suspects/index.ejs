<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h1 class="h3 mb-0 fw-bold text-dark">Criminal Records & Suspect Dossiers</h1>
        <small class="text-muted">Biometric identification profiles, documented prior convictions, and case linkages</small>
      </div>
      <div>
        <a href="/criminals/new" class="btn btn-gov-primary btn-sm">
          <i class="bi bi-person-plus-fill me-1"></i> Register Criminal Record
        </a>
      </div>
    </div>

    <% if (success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Search & Filter Controls -->
    <div class="gov-card shadow-sm border mb-4">
      <div class="gov-card-body p-3">
        <form action="/criminals" method="GET" class="row g-2 align-items-center">
          <div class="col-md-5">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" class="form-control border-start-0" name="q" placeholder="Search by name, alias, or national ID..." value="<%= query.q || '' %>">
            </div>
          </div>
          <div class="col-md-3">
            <select class="form-select form-select-sm" name="status">
              <option value="">All Legal Statuses</option>
              <option value="Wanted" <%= query.status === 'Wanted' ? 'selected' : '' %>>Wanted</option>
              <option value="In Custody" <%= query.status === 'In Custody' ? 'selected' : '' %>>In Custody</option>
              <option value="Under Surveillance" <%= query.status === 'Under Surveillance' ? 'selected' : '' %>>Under Surveillance</option>
              <option value="Person of Interest" <%= query.status === 'Person of Interest' ? 'selected' : '' %>>Person of Interest</option>
              <option value="Convicted" <%= query.status === 'Convicted' ? 'selected' : '' %>>Convicted</option>
              <option value="Cleared" <%= query.status === 'Cleared' ? 'selected' : '' %>>Cleared</option>
            </select>
          </div>
          <div class="col-md-3">
            <select class="form-select form-select-sm" name="riskLevel">
              <option value="">All Risk Tiers</option>
              <option value="Extreme" <%= query.riskLevel === 'Extreme' ? 'selected' : '' %>>Extreme Risk</option>
              <option value="High" <%= query.riskLevel === 'High' ? 'selected' : '' %>>High Risk</option>
              <option value="Moderate" <%= query.riskLevel === 'Moderate' ? 'selected' : '' %>>Moderate Risk</option>
              <option value="Low" <%= query.riskLevel === 'Low' ? 'selected' : '' %>>Low Risk</option>
            </select>
          </div>
          <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-gov-secondary btn-sm">Filter</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Criminal Profiles Grid -->
    <% const list = typeof records !== 'undefined' ? records : (typeof suspects !== 'undefined' ? suspects : []); %>
    <% if (list.length > 0) { %>
      <div class="row g-3">
        <% list.forEach(s => { %>
          <div class="col-md-6 col-lg-4">
            <div class="gov-card shadow-sm border h-100 d-flex flex-column">
              <div class="gov-card-body p-3 d-flex flex-column flex-grow-1">
                <div class="d-flex align-items-center gap-3 mb-3">
                  <img src="<%= s.photo || '/images/default-suspect.png' %>" alt="<%= s.fullName %>" class="gov-avatar-md rounded border" style="width: 60px; height: 60px; object-fit: cover;">
                  <div class="overflow-hidden">
                    <h6 class="mb-0 fw-bold text-dark text-truncate">
                      <a href="/criminals/<%= s._id %>" class="text-decoration-none text-dark">
                        <%= s.fullName %>
                      </a>
                    </h6>
                    <div class="text-muted small">Alias: "<%= s.alias || 'None' %>"</div>
                    <div class="small font-monospace text-primary"><%= s.recordNumber || 'RECORD' %></div>
                  </div>
                </div>

                <div class="d-flex gap-2 mb-3">
                  <% if (s.riskLevel === 'Extreme' || s.riskLevel === 'High') { %>
                    <span class="badge badge-soft-danger"><%= s.riskLevel %> RISK</span>
                  <% } else { %>
                    <span class="badge badge-soft-secondary"><%= s.riskLevel %> RISK</span>
                  <% } %>

                  <% if (s.status === 'In Custody' || s.status === 'Convicted') { %>
                    <span class="badge badge-soft-primary"><%= s.status %></span>
                  <% } else if (s.status === 'Wanted') { %>
                    <span class="badge badge-soft-danger"><%= s.status %></span>
                  <% } else { %>
                    <span class="badge badge-soft-secondary"><%= s.status %></span>
                  <% } %>
                </div>

                <div class="small text-muted mb-3 flex-grow-1">
                  <div><strong>Gender:</strong> <%= s.gender %> &bull; <strong>Age:</strong> <%= s.age || 'Unknown' %></div>
                  <div><strong>National ID:</strong> <%= s.nationalId || 'N/A' %></div>
                  <div><strong>Connected Cases:</strong> <%= s.connectedCases ? s.connectedCases.length : 0 %> case(s)</div>
                </div>

                <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                  <span class="text-muted font-monospace" style="font-size: 11px;">
                    Reg: <%= formatTimestamp(s.createdAt, { includeSeconds: false }) %>
                  </span>
                  <a href="/criminals/<%= s._id %>" class="btn btn-gov-secondary btn-sm py-1 px-2">
                    <i class="bi bi-file-earmark-person me-1"></i> Dossier
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="gov-card p-5 text-center text-muted">
        <i class="bi bi-person-x fs-1 mb-2 d-block text-secondary"></i>
        <h5 class="fw-bold text-dark">No Criminal Records Found</h5>
        <p class="small mb-3">No matching profiles found in the central registry with the specified criteria.</p>
        <a href="/criminals/new" class="btn btn-gov-primary btn-sm">
          <i class="bi bi-plus-lg me-1"></i> Register New Criminal Profile
        </a>
      </div>
    <% } %>

  </main>
</div>

<%- include('../partials/footer') %>
