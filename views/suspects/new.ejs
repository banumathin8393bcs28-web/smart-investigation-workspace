<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <a href="/criminals" class="btn btn-outline-secondary btn-sm py-0 px-2">&larr; Back to Registry</a>
          <span class="badge badge-soft-primary">Subject Registration</span>
        </div>
        <h1 class="h3 mb-0 fw-bold text-dark">Register Criminal Profile Dossier</h1>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="gov-card shadow-sm border">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-person-badge me-2 text-primary"></i> Identification & Biometric Information</span>
          </div>

          <div class="gov-card-body p-4">
            <form action="/criminals" method="POST" enctype="multipart/form-data">

              <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Legal Identity & Core Demographics</h6>
              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  <label class="form-label small fw-semibold" for="fullName">Full Legal Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="fullName" name="fullName" required placeholder="e.g. Marcus Vance Sterling">
                </div>

                <div class="col-md-6">
                  <label class="form-label small fw-semibold" for="alias">Alias / Known Monikers</label>
                  <input type="text" class="form-control" id="alias" name="alias" placeholder="e.g. 'The Cipher', 'Viper'">
                </div>

                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="nationalId">National Identification / Aadhaar / SSN</label>
                  <input type="text" class="form-control" id="nationalId" name="nationalId" placeholder="e.g. ID-99882211">
                </div>

                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="gender">Gender</label>
                  <select class="form-select" id="gender" name="gender">
                    <option value="Male" selected>Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                    <option value="Unknown">Unknown</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="dob">Date of Birth</label>
                  <input type="date" class="form-control" id="dob" name="dob">
                </div>

                <div class="col-md-6">
                  <label class="form-label small fw-semibold" for="phone">Contact Number</label>
                  <input type="text" class="form-control" id="phone" name="phone" placeholder="+91 98765 43210">
                </div>

                <div class="col-md-6">
                  <label class="form-label small fw-semibold" for="address">Last Known Residential Address</label>
                  <input type="text" class="form-control" id="address" name="address" placeholder="Sector 4, Rohini, New Delhi">
                </div>
              </div>

              <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">2. Legal Status, Risk Tier & Case Linkage</h6>
              <div class="row g-3 mb-4">
                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="status">Legal Classification Status</label>
                  <select class="form-select" id="status" name="status">
                    <option value="Person of Interest" selected>Person of Interest</option>
                    <option value="Wanted">Wanted (Arrest Warrant Active)</option>
                    <option value="In Custody">In Custody</option>
                    <option value="Under Surveillance">Under Surveillance</option>
                    <option value="Convicted">Convicted</option>
                    <option value="Cleared">Cleared</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="riskLevel">Assessed Risk Tier</label>
                  <select class="form-select" id="riskLevel" name="riskLevel">
                    <option value="Low">Low Risk</option>
                    <option value="Moderate" selected>Moderate Risk</option>
                    <option value="High">High Risk</option>
                    <option value="Extreme">Extreme Risk (Violent / Flight Risk)</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label small fw-semibold" for="connectedCaseId">Link to Active Case</label>
                  <select class="form-select" id="connectedCaseId" name="connectedCaseId">
                    <option value="">-- No Direct Link at Ingestion --</option>
                    <% if (cases && cases.length > 0) { %>
                      <% cases.forEach(c => { %>
                        <option value="<%= c._id %>"><%= c.caseNumber %> - <%= c.caseName %></option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>
              </div>

              <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Physical Traits & Mugshot Photograph</h6>
              <div class="row g-3 mb-4">
                <div class="col-md-3">
                  <label class="form-label small" for="height">Height</label>
                  <input type="text" class="form-control" id="height" name="height" placeholder="e.g. 5'11&quot; (180 cm)">
                </div>

                <div class="col-md-3">
                  <label class="form-label small" for="eyeColor">Eye Color</label>
                  <input type="text" class="form-control" id="eyeColor" name="eyeColor" placeholder="e.g. Brown">
                </div>

                <div class="col-md-3">
                  <label class="form-label small" for="hairColor">Hair Color</label>
                  <input type="text" class="form-control" id="hairColor" name="hairColor" placeholder="e.g. Black / Short">
                </div>

                <div class="col-md-3">
                  <label class="form-label small" for="photo">Subject Photograph</label>
                  <input type="file" class="form-control" id="photo" name="photo" accept="image/jpeg,image/png,image/webp">
                </div>

                <div class="col-12">
                  <label class="form-label small" for="identifyingMarks">Distinctive Identifying Marks / Tattoos / Scars</label>
                  <input type="text" class="form-control" id="identifyingMarks" name="identifyingMarks" placeholder="e.g. Dragon tattoo on right forearm, surgical scar on left cheek...">
                </div>
              </div>

              <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a href="/criminals" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-gov-primary px-4">
                  <i class="bi bi-shield-check me-1"></i> Register Profile Dossier
                </button>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
