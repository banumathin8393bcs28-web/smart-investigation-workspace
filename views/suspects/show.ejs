<%- include('../partials/header') %>

<% const s = typeof record !== 'undefined' ? record : suspect; %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <a href="/criminals" class="btn btn-outline-secondary btn-sm py-0 px-2">&larr; Back to Registry</a>
          <span class="badge badge-soft-primary"><%= s.recordNumber || 'CRIMINAL DOSSIER' %></span>
          <% if (s.riskLevel === 'Extreme' || s.riskLevel === 'High') { %>
            <span class="badge badge-soft-danger"><%= s.riskLevel %> RISK</span>
          <% } else { %>
            <span class="badge badge-soft-secondary"><%= s.riskLevel %> RISK</span>
          <% } %>
          <span class="badge badge-soft-primary"><%= s.status %></span>
        </div>
        <h1 class="h3 mb-0 fw-bold text-dark"><%= s.fullName %></h1>
      </div>
      <div>
        <button type="button" class="btn btn-gov-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#interrogationModal">
          <i class="bi bi-journal-plus me-1"></i> Record Interrogation Note
        </button>
      </div>
    </div>

    <% if (success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="row g-4 mb-4">

      <!-- Left Column: Mugshot Photograph & Core Identity -->
      <div class="col-lg-4">
        <div class="gov-card shadow-sm border mb-4">
          <div class="gov-card-header bg-white py-3 border-bottom text-center">
            <span class="fw-bold text-dark"><i class="bi bi-camera me-1 text-primary"></i> Identification Photograph</span>
          </div>
          <div class="gov-card-body text-center p-4 bg-light">
            <img src="<%= s.photo || '/images/default-suspect.png' %>" alt="<%= s.fullName %>" class="img-fluid rounded border shadow-sm mx-auto mb-3" style="max-height: 240px; width: 100%; object-fit: cover;">
            <h5 class="fw-bold text-dark mb-1"><%= s.fullName %></h5>
            <div class="text-muted small mb-2">Alias: "<%= s.alias || 'None' %>"</div>
            <span class="badge badge-soft-primary font-monospace"><%= s.recordNumber || 'REGISTERED' %></span>
          </div>
        </div>

        <div class="gov-card shadow-sm border">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-person-lines-fill me-2 text-primary"></i> Physical Traits</span>
          </div>
          <div class="gov-card-body p-3">
            <table class="table table-gov table-sm mb-0">
              <tbody>
                <tr><th>Height:</th><td><%= s.physicalTraits?.height || 'Not recorded' %></td></tr>
                <tr><th>Eye Color:</th><td><%= s.physicalTraits?.eyeColor || 'Not recorded' %></td></tr>
                <tr><th>Hair Color:</th><td><%= s.physicalTraits?.hairColor || 'Not recorded' %></td></tr>
                <tr><th>Distinctive Marks:</th><td class="small"><%= s.physicalTraits?.identifyingMarks || 'None noted' %></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Right Column: Case Linkages & Interrogation Notes -->
      <div class="col-lg-8">

        <!-- Demographics & Identifying Parameters -->
        <div class="gov-card shadow-sm border mb-4">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-card-text me-2 text-primary"></i> Registered Demographics</span>
          </div>
          <div class="gov-card-body p-4">
            <div class="row g-3">
              <div class="col-sm-6">
                <span class="text-muted small d-block">National Identification:</span>
                <strong><%= s.nationalId || 'Not provided' %></strong>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Gender & Age:</span>
                <strong><%= s.gender %> &bull; <%= s.age || 'Unknown' %> years</strong>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Contact Phone:</span>
                <span class="font-monospace"><%= s.phone || 'None recorded' %></span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Last Known Address:</span>
                <span><%= s.address || 'Unknown' %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Connected Investigation Cases -->
        <div class="gov-card shadow-sm border mb-4">
          <div class="gov-card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span><i class="bi bi-link-45deg me-2 text-primary"></i> Linked Investigation Cases</span>
            <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" data-bs-toggle="modal" data-bs-target="#linkCaseModal">
              <i class="bi bi-plus-lg me-1"></i> Link Active Case
            </button>
          </div>
          <div class="gov-card-body p-0">
            <% if (s.connectedCases && s.connectedCases.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-gov table-hover mb-0">
                  <thead>
                    <tr>
                      <th>Case Number</th>
                      <th>Case Title</th>
                      <th>Crime Type</th>
                      <th>Status</th>
                      <th class="text-end">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% s.connectedCases.forEach(c => { %>
                      <tr>
                        <td class="font-monospace fw-bold text-primary">
                          <%= typeof c === 'object' ? c.caseNumber : c %>
                        </td>
                        <td>
                          <%= typeof c === 'object' ? c.caseName : 'Linked Incident' %>
                        </td>
                        <td>
                          <span class="badge bg-light text-dark border">
                            <%= typeof c === 'object' ? c.crimeType : 'General' %>
                          </span>
                        </td>
                        <td>
                          <span class="badge badge-soft-primary">
                            <%= typeof c === 'object' ? c.status : 'Active' %>
                          </span>
                        </td>
                        <td class="text-end">
                          <a href="/cases/<%= typeof c === 'object' ? c._id : c %>" class="btn btn-gov-secondary btn-sm py-0 px-2">
                            View Case
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="p-4 text-center text-muted small">
                No active investigation cases linked to this criminal profile yet.
              </div>
            <% } %>
          </div>
        </div>

        <!-- Interrogation Statements & Evidentiary Observations -->
        <div class="gov-card shadow-sm border">
          <div class="gov-card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span><i class="bi bi-journal-text me-2 text-primary"></i> Interrogation Ledger (<%= s.interrogationNotes ? s.interrogationNotes.length : 0 %>)</span>
          </div>
          <div class="gov-card-body p-0">
            <% if (s.interrogationNotes && s.interrogationNotes.length > 0) { %>
              <ul class="list-group list-group-flush">
                <% s.interrogationNotes.forEach(note => { %>
                  <li class="list-group-item p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <strong class="text-dark small"><%= note.investigatorName %></strong>
                      <span class="text-muted font-monospace" style="font-size: 11px;">
                        <%= formatTimestamp(note.date) %>
                      </span>
                    </div>
                    <div class="text-secondary small" style="white-space: pre-wrap; line-height: 1.5;">
                      <%= note.notes %>
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="p-4 text-center text-muted small">
                No formal interrogation statements recorded for this subject.
              </div>
            <% } %>
          </div>
        </div>

      </div>

    </div>

  </main>
</div>

<!-- Modal: Record Interrogation Note -->
<div class="modal fade" id="interrogationModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/criminals/<%= s._id %>/interrogation" method="POST">
        <div class="modal-header">
          <h5 class="modal-title h6">Record Interrogation Note - <%= s.fullName %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold" for="intNotes">Interrogation Statement / Formal Notes</label>
            <textarea class="form-control form-control-sm" id="intNotes" name="notes" rows="4" required placeholder="Record questioning notes, alibis given, behavioral observations, or inconsistencies..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-gov-primary btn-sm">Save Note</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Link Active Case -->
<div class="modal fade" id="linkCaseModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/criminals/<%= s._id %>/link-case" method="POST">
        <div class="modal-header">
          <h5 class="modal-title h6">Link Profile to Investigation Case</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold" for="linkCaseSelect">Select Investigation Case</label>
            <select class="form-select form-select-sm" id="linkCaseSelect" name="caseId" required>
              <option value="">-- Choose Case --</option>
              <% if (typeof allCases !== 'undefined' && allCases.length > 0) { %>
                <% allCases.forEach(c => { %>
                  <option value="<%= c._id %>"><%= c.caseNumber %> - <%= c.caseName %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-gov-primary btn-sm">Link Case</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
