<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Investigator Profile & Security Credentials</h1>
        <small class="text-muted">Review registration details and manage official credentials</small>
      </div>
      <a href="/dashboard" class="btn btn-gov-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
      </a>
    </div>

    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= successMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (errors.general) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errors.general %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="row g-4">
      <!-- Left Column: Registration Details (Read-only / Identity) -->
      <div class="col-lg-4">
        <div class="gov-card shadow-sm border mb-4">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-person-vcard text-primary me-2"></i> Registered Identity</span>
          </div>
          <div class="gov-card-body text-center p-4">
            <img src="<%= investigator.profilePhoto || '/images/default-avatar.png' %>" alt="Profile" class="gov-avatar-lg mb-3 shadow-sm mx-auto">
            <h5 class="fw-bold mb-1 text-dark"><%= investigator.fullName %></h5>
            <div class="badge bg-secondary-subtle text-secondary-emphasis border mb-3"><%= investigator.role %></div>

            <ul class="list-group list-group-flush text-start small border-top pt-2">
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Username:</span>
                <strong class="text-dark font-monospace"><%= investigator.username %></strong>
              </li>
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Official Email:</span>
                <strong class="text-dark font-monospace"><%= investigator.email %></strong>
              </li>
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Date of Birth:</span>
                <span class="text-dark"><%= formatTimestamp(investigator.dob, { includeSeconds: false }) %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Registered Age:</span>
                <span class="text-dark"><%= investigator.age %> years</span>
              </li>
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Phone:</span>
                <span class="text-dark"><%= investigator.phone %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Security Question:</span>
                <span class="text-dark text-truncate" style="max-width: 170px;" title="<%= investigator.securityQuestion %>">
                  <%= investigator.securityQuestion %>
                </span>
              </li>
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Account Ingested:</span>
                <span class="text-muted font-monospace"><%= formatTimestamp(investigator.createdAt, { includeSeconds: false }) %></span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Right Column: Edit Forms -->
      <div class="col-lg-8">
        <!-- Edit Profile Details -->
        <div class="gov-card shadow-sm border mb-4">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-pencil-square text-primary me-2"></i> Update Contact & Designation Details</span>
          </div>
          <div class="gov-card-body p-4">
            <form action="/profile/edit" method="POST" enctype="multipart/form-data">
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label" for="fullName">Full Name</label>
                  <input type="text" class="form-control <%= errors.fullName ? 'is-invalid' : '' %>" id="fullName" name="fullName" value="<%= investigator.fullName %>" required>
                  <% if (errors.fullName) { %><div class="invalid-feedback"><%= errors.fullName %></div><% } %>
                </div>

                <div class="col-md-6">
                  <label class="form-label" for="role">Designation / Role</label>
                  <select class="form-select" id="role" name="role">
                    <option value="Lead Investigator" <%= investigator.role === 'Lead Investigator' ? 'selected' : '' %>>Lead Investigator</option>
                    <option value="Senior Detective" <%= investigator.role === 'Senior Detective' ? 'selected' : '' %>>Senior Detective</option>
                    <option value="Forensic Analyst" <%= investigator.role === 'Forensic Analyst' ? 'selected' : '' %>>Forensic Analyst</option>
                    <option value="Cybercrime Investigator" <%= investigator.role === 'Cybercrime Investigator' ? 'selected' : '' %>>Cybercrime Investigator</option>
                    <option value="Ballistics Expert" <%= investigator.role === 'Ballistics Expert' ? 'selected' : '' %>>Ballistics Expert</option>
                    <option value="Crime Scene Officer" <%= investigator.role === 'Crime Scene Officer' ? 'selected' : '' %>>Crime Scene Officer</option>
                  </select>
                </div>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label" for="phone">Official Phone Number</label>
                  <input type="text" class="form-control <%= errors.phone ? 'is-invalid' : '' %>" id="phone" name="phone" value="<%= investigator.phone %>" required>
                  <% if (errors.phone) { %><div class="invalid-feedback"><%= errors.phone %></div><% } %>
                </div>

                <div class="col-md-6">
                  <label class="form-label" for="gender">Gender</label>
                  <select class="form-select" id="gender" name="gender">
                    <option value="Male" <%= investigator.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%= investigator.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%= investigator.gender === 'Other' ? 'selected' : '' %>>Other</option>
                    <option value="Prefer not to say" <%= investigator.gender === 'Prefer not to say' ? 'selected' : '' %>>Prefer not to say</option>
                  </select>
                </div>
              </div>

              <div class="mb-4">
                <label class="form-label" for="profilePhoto">Replace Official Photograph</label>
                <input type="file" class="form-control image-preview-input" id="profilePhoto" name="profilePhoto" accept="image/jpeg,image/png,image/webp" data-preview="newPhotoPreview">
                <small class="text-muted">JPG, PNG, or WebP format (max 5MB).</small>
              </div>

              <button type="submit" class="btn btn-gov-primary px-4">
                <i class="bi bi-check2-circle me-1"></i> Save Profile Details
              </button>
            </form>
          </div>
        </div>

        <!-- Change Password Card -->
        <div class="gov-card shadow-sm border mb-0">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-key-fill text-primary me-2"></i> Update Security Password</span>
          </div>
          <div class="gov-card-body p-4">
            <form action="/profile/change-password" method="POST">
              <div class="mb-3">
                <label class="form-label" for="currentPassword">Current Password <span class="text-danger">*</span></label>
                <input type="password" class="form-control <%= errors.currentPassword ? 'is-invalid' : '' %>" id="currentPassword" name="currentPassword" required>
                <% if (errors.currentPassword) { %><div class="invalid-feedback"><%= errors.currentPassword %></div><% } %>
              </div>

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label" for="newPassword">New Password <span class="text-danger">*</span></label>
                  <input type="password" class="form-control <%= errors.newPassword ? 'is-invalid' : '' %>" id="newPassword" name="newPassword" required>
                  <% if (errors.newPassword) { %><div class="invalid-feedback"><%= errors.newPassword %></div><% } %>
                </div>

                <div class="col-md-6">
                  <label class="form-label" for="retypePassword">Retype New Password <span class="text-danger">*</span></label>
                  <input type="password" class="form-control <%= errors.retypePassword ? 'is-invalid' : '' %>" id="retypePassword" name="retypePassword" required>
                  <% if (errors.retypePassword) { %><div class="invalid-feedback"><%= errors.retypePassword %></div><% } %>
                </div>
              </div>

              <button type="submit" class="btn btn-gov-secondary">
                <i class="bi bi-shield-lock me-1"></i> Change Password
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
