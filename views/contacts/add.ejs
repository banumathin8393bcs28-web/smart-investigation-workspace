<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Add New Investigator Contact</h1>
        <small class="text-muted">Search for authorized government investigators by verified @gov.in email</small>
      </div>
      <a href="/contacts" class="btn btn-gov-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Return to Contacts
      </a>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">

        <!-- Search Card -->
        <div class="gov-card mb-4 shadow-sm border">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold"><i class="bi bi-search me-2 text-primary"></i> Investigator Search Directory</h5>
          </div>
          <div class="gov-card-body p-4">
            <form action="/contacts/search" method="POST">
              <label class="form-label" for="email">Search Official Government Email <span class="text-danger">*</span></label>
              <div class="input-group mb-2">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" class="form-control <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" value="<%= searchQuery || '' %>" placeholder="e.g. david.chen@gov.in" required autofocus>
                <button type="submit" class="btn btn-gov-primary px-3">
                  <i class="bi bi-search me-1"></i> Search Directory
                </button>
                <% if (errors.email) { %><div class="invalid-feedback d-block"><%= errors.email %></div><% } %>
              </div>
              <small class="text-muted" style="font-size: 11px;">
                To prevent arbitrary unsolicited connections, trusted contacts can only be established with confirmed registered investigator accounts.
              </small>
            </form>
          </div>
        </div>

        <!-- Search Result Card (if found) -->
        <% if (searchResult) { %>
          <div class="gov-card shadow-sm border-primary mb-0">
            <div class="gov-card-header bg-primary-subtle py-3 border-bottom text-primary fw-bold">
              <span><i class="bi bi-person-check text-success me-2"></i> Verified Official Profile Located</span>
            </div>
            <div class="gov-card-body p-4">
              <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded border">
                <img src="<%= searchResult.profilePhoto || '/images/default-avatar.png' %>" alt="Photo" class="gov-avatar-md shadow-sm">
                <div>
                  <h5 class="fw-bold mb-1 text-dark"><%= searchResult.fullName %></h5>
                  <span class="badge bg-secondary-subtle text-secondary-emphasis border mb-1"><%= searchResult.role %></span>
                  <div class="text-muted font-monospace small"><%= searchResult.email %></div>
                </div>
              </div>

              <% if (existingStatus === 'Accepted') { %>
                <div class="alert alert-info alert-gov py-3 mb-0 d-flex justify-content-between align-items-center">
                  <div>
                    <i class="bi bi-check-circle-fill text-success me-2"></i> Already connected as a verified colleague.
                  </div>
                  <a href="/messages?recipientId=<%= searchResult._id %>" class="btn btn-gov-primary btn-sm">
                    Open Conversation &rarr;
                  </a>
                </div>
              <% } else if (existingStatus === 'Pending') { %>
                <div class="alert alert-warning alert-gov py-2 mb-0">
                  <i class="bi bi-clock-history me-1"></i> Connection request already pending review.
                </div>
              <% } else { %>
                <form action="/contacts/request" method="POST">
                  <input type="hidden" name="contactId" value="<%= searchResult._id %>">
                  <div class="mb-3">
                    <label class="form-label small" for="displayName">Custom Display Alias (Optional)</label>
                    <input type="text" class="form-control" id="displayName" name="displayName" placeholder="e.g. Lead Detective Chen">
                  </div>
                  <div class="mb-4">
                    <label class="form-label small" for="notes">Introductory Note</label>
                    <input type="text" class="form-control" id="notes" name="notes" placeholder="e.g. Requesting collaboration on homicide / cyber forensics cases.">
                  </div>
                  <button type="submit" class="btn btn-gov-primary w-100 py-2">
                    <i class="bi bi-person-plus me-1"></i> Send Connection Request
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% } %>

      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
