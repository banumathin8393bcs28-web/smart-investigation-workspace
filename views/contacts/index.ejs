<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Investigator Contacts</h1>
        <small class="text-muted">Manage verified colleague connections and initiate secure messaging</small>
      </div>
      <div class="d-flex gap-2">
        <a href="/contacts/add" class="btn btn-gov-primary btn-sm">
          <i class="bi bi-person-plus-fill me-1"></i> Add New Contact
        </a>
        <a href="/messages" class="btn btn-gov-secondary btn-sm">
          <i class="bi bi-chat-left-text me-1"></i> Open Chat Interface
        </a>
      </div>
    </div>

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Incoming Connection Requests (if any) -->
    <% if (incomingRequests && incomingRequests.length > 0) { %>
      <div class="gov-card border-warning mb-4 shadow-sm">
        <div class="gov-card-header bg-warning-subtle text-dark py-3">
          <span class="fw-bold"><i class="bi bi-person-exclamation me-2 text-warning"></i> Incoming Connection Requests (<%= incomingRequests.length %> Pending Approval)</span>
        </div>
        <div class="gov-card-body p-0">
          <ul class="list-group list-group-flush small">
            <% incomingRequests.forEach(reqItem => { %>
              <li class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center p-3 gap-2">
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= reqItem.owner.profilePhoto || '/images/default-avatar.png' %>" alt="Photo" class="gov-avatar-sm" style="width: 40px; height: 40px;">
                  <div>
                    <strong class="text-dark"><%= reqItem.owner.fullName %></strong>
                    <span class="text-muted">&bull; <%= reqItem.owner.role %></span>
                    <div class="text-muted font-monospace" style="font-size: 11px;"><%= reqItem.owner.email %></div>
                  </div>
                </div>
                <div class="d-flex gap-2">
                  <form action="/contacts/accept/<%= reqItem._id %>" method="POST">
                    <button type="submit" class="btn btn-gov-primary btn-sm">
                      <i class="bi bi-check-lg me-1"></i> Accept Connection
                    </button>
                  </form>
                  <form action="/contacts/reject/<%= reqItem._id %>" method="POST">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                      <i class="bi bi-x-lg me-1"></i> Reject
                    </button>
                  </form>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } %>

    <!-- Contacts Directory -->
    <div class="gov-card shadow-sm">
      <div class="gov-card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people text-primary me-2"></i> Verified Official Investigator Network (<%= contacts.length %> Connections)</span>
      </div>
      <div class="gov-card-body p-4">
        <% if (contacts && contacts.length > 0) { %>
          <div class="row g-3">
            <% contacts.forEach(c => { %>
              <div class="col-md-6 col-xl-4">
                <div class="card h-100 border shadow-sm">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-start gap-3 mb-3">
                      <div class="position-relative">
                        <img src="<%= c.contact.profilePhoto || '/images/default-avatar.png' %>" alt="<%= c.contact.fullName %>" class="gov-avatar-md shadow-sm">
                        <span class="position-absolute bottom-0 end-0 p-1 bg-<%= c.isOnline ? 'success' : 'secondary' %> border border-white rounded-circle" style="width: 12px; height: 12px;" title="<%= c.isOnline ? 'Online' : 'Offline' %>"></span>
                      </div>
                      <div class="overflow-hidden flex-grow-1">
                        <h6 class="fw-bold mb-0 text-dark text-truncate"><%= c.displayName || c.contact.fullName %></h6>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border mb-1" style="font-size: 10px;">
                          <%= c.contact.role %>
                        </span>
                        <div class="text-muted text-truncate font-monospace" style="font-size: 11px;"><%= c.contact.email %></div>
                      </div>
                    </div>

                    <% if (c.notes) { %>
                      <p class="small text-muted mb-3 text-truncate fst-italic" title="<%= c.notes %>">
                        "<%= c.notes %>"
                      </p>
                    <% } %>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                      <a href="/messages?recipientId=<%= c.contact._id %>" class="btn btn-gov-primary btn-sm position-relative">
                        <i class="bi bi-chat-dots me-1"></i> Send Message
                        <% if (c.unreadCount > 0) { %>
                          <span class="badge bg-danger ms-1"><%= c.unreadCount %></span>
                        <% } %>
                      </a>

                      <form action="/contacts/remove/<%= c._id %>" method="POST" onsubmit="return confirm('Remove contact connection?');">
                        <button type="submit" class="btn btn-outline-secondary btn-sm text-muted" title="Remove Connection">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="p-5 text-center text-muted">
            <i class="bi bi-people fs-2 mb-2 d-block text-secondary"></i>
            No colleague contacts connected yet. Establish connections with other certified investigators.
            <div class="mt-3">
              <a href="/contacts/add" class="btn btn-gov-primary btn-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Search & Connect Colleague
              </a>
            </div>
          </div>
        <% } %>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
