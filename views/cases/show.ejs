<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Case Header & Action Buttons -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="badge bg-dark fs-6"><%= caseDoc.caseNumber %></span>
          <h1 class="h4 mb-0 fw-bold text-dark"><%= caseDoc.caseName %></h1>
          <span class="badge <%= caseDoc.status === 'Closed' ? 'bg-secondary' : (caseDoc.status === 'Under Investigation' ? 'bg-primary' : 'bg-warning text-dark') %>">
            <%= caseDoc.status %>
          </span>
        </div>
        <div class="text-muted small">
          Crime Classification: <strong class="text-dark"><%= caseDoc.crimeType %><%= caseDoc.crimeTypeOther ? ` (${caseDoc.crimeTypeOther})` : '' %></strong> &bull;
          Location: <strong class="text-dark"><%= caseDoc.incidentLocation %></strong> &bull;
          Assigned Officer: <strong class="text-dark"><%= caseDoc.assignedName %></strong>
        </div>
      </div>

      <!-- Action Buttons Bar -->
      <div class="d-flex flex-wrap gap-2">
        <a href="/cases/<%= caseDoc._id %>/edit" class="btn btn-gov-secondary btn-sm" title="Edit Case Details">
          <i class="bi bi-pencil-square me-1"></i> Edit Case Details
        </a>
        <a href="/evidence/upload?caseId=<%= caseDoc._id %>" class="btn btn-gov-primary btn-sm" title="Add Crime-Scene Pictures">
          <i class="bi bi-camera-fill me-1"></i> Add Crime-Scene Pictures
        </a>
        <a href="/custody/transfer-case?caseId=<%= caseDoc._id %>" class="btn btn-gov-secondary btn-sm" title="Transfer Case">
          <i class="bi bi-arrow-left-right me-1"></i> Transfer Case
        </a>
        <form action="/reports/generate" method="POST" class="d-inline">
          <input type="hidden" name="caseId" value="<%= caseDoc._id %>">
          <button type="submit" class="btn btn-danger btn-sm">
            <i class="bi bi-file-earmark-pdf me-1"></i> Generate Case Report
          </button>
        </form>
      </div>
    </div>

    <!-- Navigation jump anchors -->
    <div class="mb-3 d-flex gap-3 small border-bottom pb-2">
      <a href="#details-section" class="text-decoration-none text-muted fw-semibold">Incident Details</a>
      <a href="#evidence-section" class="text-decoration-none text-primary fw-semibold">Evidence & Photographs (<%= evidenceList.length %>)</a>
      <a href="#custody-section" class="text-decoration-none text-muted fw-semibold">Chain of Custody (<%= custodyHistory.length %>)</a>
      <a href="#activity-section" class="text-decoration-none text-muted fw-semibold">Audit Activity (<%= auditLogs.length %>)</a>
    </div>

    <!-- 1. Case Details Section -->
    <div class="gov-card mb-4" id="details-section">
      <div class="gov-card-header">
        <span><i class="bi bi-info-circle me-2"></i> Comprehensive Case & Incident Record</span>
        <span class="text-muted small">
          Ingested on <%= formatTimestamp(caseDoc.creationTimestamp) %>
        </span>
      </div>
      <div class="gov-card-body">
        <div class="row g-3 mb-3">
          <div class="col-md-3">
            <span class="text-muted small d-block">Incident Date & Time</span>
            <strong><%= formatTimestamp(caseDoc.incidentDate, { includeSeconds: false }) %> at <%= caseDoc.incidentTime %></strong>
          </div>
          <div class="col-md-3">
            <span class="text-muted small d-block">Incident Location</span>
            <strong><%= caseDoc.incidentLocation %></strong>
          </div>
          <div class="col-md-3">
            <span class="text-muted small d-block">Street Address</span>
            <strong><%= caseDoc.crimeSceneAddress || 'Not specified' %></strong>
          </div>
          <div class="col-md-3">
            <span class="text-muted small d-block">Department Unit</span>
            <strong><%= caseDoc.department %></strong>
          </div>
        </div>

        <div class="mb-3">
          <span class="text-muted small d-block mb-1">Detailed Case Narrative:</span>
          <div class="p-3 border rounded bg-light" style="line-height: 1.6;">
            <%= caseDoc.caseDescription %>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <span class="text-muted small d-block">Known Objects / AI Detection Context Targets:</span>
            <div class="p-2 border rounded bg-light">
              <%= caseDoc.knownObjects || 'None specified' %>
            </div>
          </div>
          <div class="col-md-6">
            <span class="text-muted small d-block">Preliminary Findings:</span>
            <div class="p-2 border rounded bg-light">
              <%= caseDoc.preliminaryFindings || 'None recorded' %>
            </div>
          </div>
        </div>

        <% if (caseDoc.victimDetails || caseDoc.suspectDetails || caseDoc.witnessDetails) { %>
          <div class="row g-3 mb-3">
            <% if (caseDoc.victimDetails) { %>
              <div class="col-md-4">
                <span class="text-muted small d-block">Victim Details:</span>
                <div class="p-2 border rounded bg-light small"><%= caseDoc.victimDetails %></div>
              </div>
            <% } %>
            <% if (caseDoc.suspectDetails) { %>
              <div class="col-md-4">
                <span class="text-muted small d-block">Suspect Details:</span>
                <div class="p-2 border rounded bg-light small"><%= caseDoc.suspectDetails %></div>
              </div>
            <% } %>
            <% if (caseDoc.witnessDetails) { %>
              <div class="col-md-4">
                <span class="text-muted small d-block">Witness Details:</span>
                <div class="p-2 border rounded bg-light small"><%= caseDoc.witnessDetails %></div>
              </div>
            <% } %>
          </div>
        <% } %>

        <% if (caseDoc.additionalNotes) { %>
          <div class="mb-2">
            <span class="text-muted small d-block">Additional Notes:</span>
            <div class="p-2 border rounded bg-light small"><%= caseDoc.additionalNotes %></div>
          </div>
        <% } %>

        <div class="text-muted small pt-2 border-top mt-3 d-flex justify-content-between">
          <span>Reporting Officer: <%= caseDoc.reportingInvestigator %> (Original Creator: <%= caseDoc.creatorName %>)</span>
          <span>Last Authoritative Update: <%= formatTimestamp(caseDoc.lastUpdatedTimestamp) %> by <%= caseDoc.lastUpdatedByName || caseDoc.assignedName %></span>
        </div>
      </div>
    </div>

    <!-- 2. Crime-Scene Photographs & Digital Evidence -->
    <div class="gov-card mb-4" id="evidence-section">
      <div class="gov-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-images me-2"></i> Crime-Scene Digital Evidence (<%= evidenceList.length %> Artifacts)</span>
        <a href="/evidence/upload?caseId=<%= caseDoc._id %>" class="btn btn-gov-primary btn-sm py-0 px-2 small">
          <i class="bi bi-plus"></i> Upload Photographs
        </a>
      </div>
      <div class="gov-card-body p-3">
        <% if (evidenceList.length > 0) { %>
          <div class="row g-3">
            <% evidenceList.forEach(ev => { %>
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 border">
                  <!-- Thumbnail / Image View -->
                  <div class="text-center p-2 bg-light border-bottom position-relative" style="height: 190px; overflow: hidden;">
                    <a href="/evidence/<%= ev._id %>">
                      <img src="/evidence/<%= ev._id %>/thumbnail" alt="<%= ev.evidenceIdentifier %>" class="img-fluid rounded" style="max-height: 175px; object-fit: contain;">
                    </a>
                    <span class="position-absolute top-0 end-0 m-2 badge <%= ev.inspectionStatus === 'Inspected' ? 'bg-success' : 'bg-secondary' %>">
                      <%= ev.inspectionStatus %>
                    </span>
                  </div>

                  <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                      <a href="/evidence/<%= ev._id %>" class="fw-bold text-decoration-none text-primary">
                        <%= ev.evidenceIdentifier %>
                      </a>
                      <span class="text-muted small"><%= (ev.fileSize / 1024).toFixed(1) %> KB</span>
                    </div>

                    <div class="small text-truncate mb-2" title="<%= ev.originalFilename %>">
                      <i class="bi bi-file-earmark-image me-1"></i> <%= ev.originalFilename %>
                    </div>

                    <% if (ev.description) { %>
                      <p class="small text-muted mb-2 text-truncate" title="<%= ev.description %>">
                        <%= ev.description %>
                      </p>
                    <% } %>

                    <div class="mb-2">
                      <span class="text-muted small d-block" style="font-size: 11px;">SHA-256 Digest:</span>
                      <div class="d-flex gap-1 align-items-center">
                        <span class="gov-hash flex-grow-1 text-truncate" style="font-size: 10px;" title="<%= ev.sha256Hash %>">
                          <%= ev.sha256Hash.substring(0, 18) %>...
                        </span>
                        <button class="btn btn-outline-secondary btn-sm py-0 px-1 btn-copy-hash" data-hash="<%= ev.sha256Hash %>" title="Copy Hash">
                          <i class="bi bi-clipboard"></i>
                        </button>
                      </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
                      <a href="/evidence/<%= ev._id %>" class="btn btn-gov-secondary btn-sm py-1">
                        <i class="bi bi-search me-1"></i> Inspect
                      </a>
                      <a href="/evidence/<%= ev._id %>/file" class="btn btn-outline-secondary btn-sm py-1" download title="Download Original">
                        <i class="bi bi-download"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="p-4 text-center text-muted">
            <i class="bi bi-camera fs-2 mb-2 d-block"></i>
            No crime-scene images uploaded yet.
            <div class="mt-2">
              <a href="/evidence/upload?caseId=<%= caseDoc._id %>" class="btn btn-gov-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Crime-Scene Pictures
              </a>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- 3. Chain of Custody History -->
    <div class="gov-card mb-4" id="custody-section">
      <div class="gov-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-shield-check me-2"></i> Chronological Chain of Custody Ledger</span>
        <a href="/custody?caseId=<%= caseDoc._id %>" class="btn btn-gov-secondary btn-sm py-0 px-2 small">Full Ledger</a>
      </div>
      <div class="gov-card-body p-0">
        <% if (custodyHistory.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-gov mb-0">
              <thead>
                <tr>
                  <th>Event ID</th>
                  <th>Action</th>
                  <th>Actor / Officer</th>
                  <th>Transfer Details</th>
                  <th>Reason</th>
                  <th>Timestamp</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% custodyHistory.forEach(cust => { %>
                  <tr>
                    <td class="fw-bold"><%= cust.eventId %></td>
                    <td><span class="badge bg-light text-dark border"><%= cust.action %></span></td>
                    <td><%= cust.actorName %></td>
                    <td class="small">
                      <%= cust.transferorName ? `${cust.transferorName} &rarr; ${cust.recipientName}` : 'Internal Custody Action' %>
                    </td>
                    <td class="small"><%= cust.reason %></td>
                    <td class="small text-muted"><%= formatTimestamp(cust.eventTimestamp) %></td>
                    <td>
                      <span class="badge <%= cust.status === 'Completed' ? 'bg-success' : (cust.status === 'Pending' ? 'bg-warning text-dark' : 'bg-secondary') %>">
                        <%= cust.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-3 text-muted text-center small">No custody events recorded for this case.</div>
        <% } %>
      </div>
    </div>

    <!-- 4. Case Audit History -->
    <div class="gov-card" id="activity-section">
      <div class="gov-card-header">
        <span><i class="bi bi-journal-text me-2"></i> Case Security & Modification Audit Trail</span>
      </div>
      <div class="gov-card-body p-0">
        <% if (auditLogs.length > 0) { %>
          <ul class="list-group list-group-flush small">
            <% auditLogs.forEach(log => { %>
              <li class="list-group-item d-flex justify-content-between align-items-start py-2 px-3">
                <div>
                  <span class="badge bg-light text-dark border me-1"><%= log.action %></span>
                  <strong><%= log.changeSummary %></strong>
                  <div class="text-muted" style="font-size: 11px;">
                    Officer: <%= log.actorName %> &bull; IP: <%= log.ipAddress %>
                  </div>
                </div>
                <span class="text-muted small text-nowrap"><%= formatTimestamp(log.timestamp) %></span>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <div class="p-3 text-muted text-center small">No audit log records for this case.</div>
        <% } %>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
