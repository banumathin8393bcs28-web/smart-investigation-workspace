<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Edit Case: <%= caseDoc.caseNumber %></h1>
        <small class="text-muted">Modify authorized case details. Core creation identifiers remain immutable.</small>
      </div>
      <a href="/cases/<%= caseDoc._id %>" class="btn btn-gov-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Return to Case Details
      </a>
    </div>

    <% if (errors.general) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errors.general %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="gov-card shadow-sm border">
      <div class="gov-card-header bg-white py-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-pencil-square text-primary fs-4"></i>
          <div>
            <h5 class="mb-0 fw-bold">Case Modification Record</h5>
            <small class="text-muted">Case Number: <strong class="text-dark font-monospace"><%= caseDoc.caseNumber %></strong> &bull; Original Creator: <%= caseDoc.creatorName %></small>
          </div>
        </div>
        <span class="badge bg-light text-muted border">
          Immutable Ingestion: <%= formatTimestamp(caseDoc.creationTimestamp) %>
        </span>
      </div>

      <div class="gov-card-body p-4">
        <form action="/cases/<%= caseDoc._id %>/edit" method="POST">

          <!-- Core details -->
          <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
            <span class="badge bg-primary text-white" style="font-size: 11px;">1</span>
            <h6 class="text-uppercase text-dark mb-0 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Core Specifications
            </h6>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label" for="caseName">Case Title <span class="text-danger">*</span></label>
              <input type="text" class="form-control <%= errors.caseName ? 'is-invalid' : '' %>" id="caseName" name="caseName" value="<%= caseDoc.caseName %>" required>
              <% if (errors.caseName) { %><div class="invalid-feedback"><%= errors.caseName %></div><% } %>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="crimeType">Crime Classification <span class="text-danger">*</span></label>
              <select class="form-select <%= errors.crimeType ? 'is-invalid' : '' %>" id="crimeType" name="crimeType" required onchange="toggleCrimeOther(this.value)">
                <option value="Theft" <%= caseDoc.crimeType === 'Theft' ? 'selected' : '' %>>Theft</option>
                <option value="Murder" <%= caseDoc.crimeType === 'Murder' ? 'selected' : '' %>>Murder</option>
                <option value="Robbery" <%= caseDoc.crimeType === 'Robbery' ? 'selected' : '' %>>Robbery</option>
                <option value="Assault" <%= caseDoc.crimeType === 'Assault' ? 'selected' : '' %>>Assault</option>
                <option value="Burglary" <%= caseDoc.crimeType === 'Burglary' ? 'selected' : '' %>>Burglary</option>
                <option value="Cybercrime" <%= caseDoc.crimeType === 'Cybercrime' ? 'selected' : '' %>>Cybercrime</option>
                <option value="Fraud" <%= caseDoc.crimeType === 'Fraud' ? 'selected' : '' %>>Fraud</option>
                <option value="Missing Person" <%= caseDoc.crimeType === 'Missing Person' ? 'selected' : '' %>>Missing Person</option>
                <option value="Drug-Related Crime" <%= caseDoc.crimeType === 'Drug-Related Crime' ? 'selected' : '' %>>Drug-Related Crime</option>
                <option value="Other" <%= caseDoc.crimeType === 'Other' ? 'selected' : '' %>>Other</option>
              </select>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="status">Current Status <span class="text-danger">*</span></label>
              <select class="form-select <%= errors.status ? 'is-invalid' : '' %>" id="status" name="status" required>
                <option value="New" <%= caseDoc.status === 'New' ? 'selected' : '' %>>New</option>
                <option value="Under Investigation" <%= caseDoc.status === 'Under Investigation' ? 'selected' : '' %>>Under Investigation</option>
                <option value="Pending" <%= caseDoc.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                <option value="Transferred" <%= caseDoc.status === 'Transferred' ? 'selected' : '' %>>Transferred</option>
                <option value="Closed" <%= caseDoc.status === 'Closed' ? 'selected' : '' %>>Closed</option>
              </select>
            </div>

            <div class="col-md-6 <%= caseDoc.crimeType === 'Other' ? '' : 'd-none' %>" id="crimeTypeOtherContainer">
              <label class="form-label" for="crimeTypeOther">Specify Other Classification</label>
              <input type="text" class="form-control" id="crimeTypeOther" name="crimeTypeOther" value="<%= caseDoc.crimeTypeOther || '' %>">
            </div>
          </div>

          <!-- Time & Location -->
          <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
            <span class="badge bg-primary text-white" style="font-size: 11px;">2</span>
            <h6 class="text-uppercase text-dark mb-0 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Incident Date, Time & Location
            </h6>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-3">
              <label class="form-label" for="incidentDate">Incident Date <span class="text-danger">*</span></label>
              <%
                const dateVal = caseDoc.incidentDate ? new Date(caseDoc.incidentDate).toISOString().split('T')[0] : '';
              %>
              <input type="date" class="form-control" id="incidentDate" name="incidentDate" value="<%= dateVal %>" required>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="incidentTime">Incident Time <span class="text-danger">*</span></label>
              <input type="time" class="form-control" id="incidentTime" name="incidentTime" value="<%= caseDoc.incidentTime %>" required>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="incidentLocation">Location Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="incidentLocation" name="incidentLocation" value="<%= caseDoc.incidentLocation %>" required>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="crimeSceneAddress">Street Address</label>
              <input type="text" class="form-control" id="crimeSceneAddress" name="crimeSceneAddress" value="<%= caseDoc.crimeSceneAddress || '' %>">
            </div>
          </div>

          <!-- Narrative & Findings -->
          <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
            <span class="badge bg-primary text-white" style="font-size: 11px;">3</span>
            <h6 class="text-uppercase text-dark mb-0 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Narrative & Evidence Markers
            </h6>
          </div>

          <div class="mb-3">
            <label class="form-label" for="caseDescription">Detailed Narrative <span class="text-danger">*</span></label>
            <textarea class="form-control" id="caseDescription" name="caseDescription" rows="4" required><%= caseDoc.caseDescription %></textarea>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label" for="knownObjects">Known Context Objects / AI Keywords</label>
              <input type="text" class="form-control" id="knownObjects" name="knownObjects" value="<%= caseDoc.knownObjects || '' %>">
            </div>

            <div class="col-md-6">
              <label class="form-label" for="preliminaryFindings">Preliminary Findings</label>
              <input type="text" class="form-control" id="preliminaryFindings" name="preliminaryFindings" value="<%= caseDoc.preliminaryFindings || '' %>">
            </div>
          </div>

          <!-- Parties & Notes -->
          <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
            <span class="badge bg-primary text-white" style="font-size: 11px;">4</span>
            <h6 class="text-uppercase text-dark mb-0 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Associated Parties & Additional Notes
            </h6>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label" for="victimDetails">Victim Details</label>
              <input type="text" class="form-control" id="victimDetails" name="victimDetails" value="<%= caseDoc.victimDetails || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="suspectDetails">Suspect Details</label>
              <input type="text" class="form-control" id="suspectDetails" name="suspectDetails" value="<%= caseDoc.suspectDetails || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="witnessDetails">Witness Details</label>
              <input type="text" class="form-control" id="witnessDetails" name="witnessDetails" value="<%= caseDoc.witnessDetails || '' %>">
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label" for="additionalNotes">Additional Notes / Follow-up Tasks</label>
            <textarea class="form-control" id="additionalNotes" name="additionalNotes" rows="2"><%= caseDoc.additionalNotes || '' %></textarea>
          </div>

          <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <a href="/cases/<%= caseDoc._id %>" class="btn btn-gov-secondary">
              <i class="bi bi-x-circle me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-gov-primary px-4 py-2">
              <i class="bi bi-check2-circle me-1"></i> Save Changes & Log Audit Entry
            </button>
          </div>

        </form>
      </div>
    </div>
  </main>
</div>

<script>
  function toggleCrimeOther(val) {
    const el = document.getElementById('crimeTypeOtherContainer');
    if (el) {
      if (val === 'Other') el.classList.remove('d-none');
      else el.classList.add('d-none');
    }
  }
</script>

<%- include('../partials/footer') %>
