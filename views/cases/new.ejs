<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Ingest New Investigation Case</h1>
        <small class="text-muted">Register an authorized forensic case into the central workspace ledger</small>
      </div>
      <a href="/cases" class="btn btn-gov-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> View Existing Cases
      </a>
    </div>

    <% if (errors.general) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errors.general %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="gov-card shadow-sm border">
      <div class="gov-card-header bg-white py-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-folder-plus text-primary fs-4"></i>
          <div>
            <h5 class="mb-0 fw-bold">Official Case Intake Form</h5>
            <small class="text-muted">Case number will be atomically assigned (e.g. CASE001, CASE002...) by the server</small>
          </div>
        </div>
        <div>
          <span class="badge bg-light text-dark border">
            <i class="bi bi-clock me-1"></i> Authoritative Timestamp Recorded at Ingestion
          </span>
        </div>
      </div>

      <div class="gov-card-body p-4">

        <form action="/cases/new" method="POST" id="caseForm">

          <!-- Section 1: Classification & Core Identifiers -->
          <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
            <span class="badge bg-primary text-white" style="font-size: 11px;">1</span>
            <h6 class="text-uppercase text-dark mb-0 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Core Case Specifications
            </h6>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label" for="caseName">Case Title / Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control <%= errors.caseName ? 'is-invalid' : '' %>" id="caseName" name="caseName" value="<%= formData.caseName || '' %>" placeholder="e.g. Armed Robbery at Central Commercial Bank" required>
              <% if (errors.caseName) { %><div class="invalid-feedback"><%= errors.caseName %></div><% } %>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="crimeType">Crime Classification <span class="text-danger">*</span></label>
              <select class="form-select <%= errors.crimeType ? 'is-invalid' : '' %>" id="crimeType" name="crimeType" required onchange="toggleCrimeOther(this.value)">
                <option value="">Select crime type...</option>
                <option value="Theft" <%= formData.crimeType === 'Theft' ? 'selected' : '' %>>Theft</option>
                <option value="Murder" <%= formData.crimeType === 'Murder' ? 'selected' : '' %>>Murder</option>
                <option value="Robbery" <%= formData.crimeType === 'Robbery' ? 'selected' : '' %>>Robbery</option>
                <option value="Assault" <%= formData.crimeType === 'Assault' ? 'selected' : '' %>>Assault</option>
                <option value="Burglary" <%= formData.crimeType === 'Burglary' ? 'selected' : '' %>>Burglary</option>
                <option value="Cybercrime" <%= formData.crimeType === 'Cybercrime' ? 'selected' : '' %>>Cybercrime</option>
                <option value="Fraud" <%= formData.crimeType === 'Fraud' ? 'selected' : '' %>>Fraud</option>
                <option value="Missing Person" <%= formData.crimeType === 'Missing Person' ? 'selected' : '' %>>Missing Person</option>
                <option value="Drug-Related Crime" <%= formData.crimeType === 'Drug-Related Crime' ? 'selected' : '' %>>Drug-Related Crime</option>
                <option value="Other" <%= formData.crimeType === 'Other' ? 'selected' : '' %>>Other</option>
              </select>
              <% if (errors.crimeType) { %><div class="invalid-feedback"><%= errors.crimeType %></div><% } %>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="status">Initial Status <span class="text-danger">*</span></label>
              <select class="form-select <%= errors.status ? 'is-invalid' : '' %>" id="status" name="status" required>
                <option value="New" <%= (!formData.status || formData.status === 'New') ? 'selected' : '' %>>New</option>
                <option value="Under Investigation" <%= formData.status === 'Under Investigation' ? 'selected' : '' %>>Under Investigation</option>
                <option value="Pending" <%= formData.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                <option value="Transferred" <%= formData.status === 'Transferred' ? 'selected' : '' %>>Transferred</option>
                <option value="Closed" <%= formData.status === 'Closed' ? 'selected' : '' %>>Closed</option>
              </select>
              <% if (errors.status) { %><div class="invalid-feedback"><%= errors.status %></div><% } %>
            </div>

            <div class="col-md-6 <%= formData.crimeType === 'Other' ? '' : 'd-none' %>" id="crimeTypeOtherContainer">
              <label class="form-label" for="crimeTypeOther">Specify Other Classification</label>
              <input type="text" class="form-control" id="crimeTypeOther" name="crimeTypeOther" value="<%= formData.crimeTypeOther || '' %>" placeholder="e.g. Arson / Extortion">
            </div>
          </div>

          <!-- Section 2: Time & Location -->
          <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
            <span class="badge bg-primary text-white" style="font-size: 11px;">2</span>
            <h6 class="text-uppercase text-dark mb-0 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Incident Date, Time & Crime Scene Location
            </h6>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-3">
              <label class="form-label" for="incidentDate">Incident Date <span class="text-danger">*</span></label>
              <input type="date" class="form-control <%= errors.incidentDate ? 'is-invalid' : '' %>" id="incidentDate" name="incidentDate" value="<%= formData.incidentDate || '' %>" required>
              <% if (errors.incidentDate) { %><div class="invalid-feedback"><%= errors.incidentDate %></div><% } %>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="incidentTime">Incident Time (24h) <span class="text-danger">*</span></label>
              <input type="time" class="form-control <%= errors.incidentTime ? 'is-invalid' : '' %>" id="incidentTime" name="incidentTime" value="<%= formData.incidentTime || '12:00' %>" required>
              <% if (errors.incidentTime) { %><div class="invalid-feedback"><%= errors.incidentTime %></div><% } %>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="incidentLocation">General Incident Location <span class="text-danger">*</span></label>
              <input type="text" class="form-control <%= errors.incidentLocation ? 'is-invalid' : '' %>" id="incidentLocation" name="incidentLocation" value="<%= formData.incidentLocation || '' %>" placeholder="e.g. South Delhi, Sector 4" required>
              <% if (errors.incidentLocation) { %><div class="invalid-feedback"><%= errors.incidentLocation %></div><% } %>
            </div>

            <div class="col-md-3">
              <label class="form-label" for="crimeSceneAddress">Street Address / Landmark</label>
              <input type="text" class="form-control" id="crimeSceneAddress" name="crimeSceneAddress" value="<%= formData.crimeSceneAddress || '' %>" placeholder="e.g. Building 44, Commercial Avenue">
            </div>
          </div>

          <!-- Section 3: Narrative & AI Context -->
          <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
            <span class="badge bg-primary text-white" style="font-size: 11px;">3</span>
            <h6 class="text-uppercase text-dark mb-0 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Incident Narrative & AI Detection Context
            </h6>
          </div>

          <div class="mb-3">
            <label class="form-label" for="caseDescription">Detailed Incident Narrative <span class="text-danger">*</span></label>
            <textarea class="form-control <%= errors.caseDescription ? 'is-invalid' : '' %>" id="caseDescription" name="caseDescription" rows="4" placeholder="Enter comprehensive narrative describing the crime scene, suspect actions, weapons involved, vehicle descriptions, or stolen articles..." required><%= formData.caseDescription || '' %></textarea>
            <small class="text-muted">Minimum 10 characters. Context keywords will be automatically correlated with YOLOv8 object detection.</small>
            <% if (errors.caseDescription) { %><div class="invalid-feedback"><%= errors.caseDescription %></div><% } %>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label" for="knownObjects">Target Context Objects / Keywords</label>
              <input type="text" class="form-control" id="knownObjects" name="knownObjects" value="<%= formData.knownObjects || '' %>" placeholder="e.g. knife, handgun, duffel bag, motorcycle, phone">
              <small class="text-muted">Comma-separated objects for prioritized AI detection correlation.</small>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="preliminaryFindings">Preliminary Findings / Evidence Markers</label>
              <input type="text" class="form-control" id="preliminaryFindings" name="preliminaryFindings" value="<%= formData.preliminaryFindings || '' %>" placeholder="e.g. Forced entry at rear door; 3 cartridge cases recovered">
            </div>
          </div>

          <!-- Section 4: Associated Individuals -->
          <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
            <span class="badge bg-primary text-white" style="font-size: 11px;">4</span>
            <h6 class="text-uppercase text-dark mb-0 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Associated Parties (Victims, Suspects, Witnesses)
            </h6>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <label class="form-label" for="victimDetails">Victim Identification</label>
              <input type="text" class="form-control" id="victimDetails" name="victimDetails" value="<%= formData.victimDetails || '' %>" placeholder="e.g. Rohit Kumar, 38, Store Manager">
            </div>

            <div class="col-md-4">
              <label class="form-label" for="suspectDetails">Suspect Description / Leads</label>
              <input type="text" class="form-control" id="suspectDetails" name="suspectDetails" value="<%= formData.suspectDetails || '' %>" placeholder="e.g. 2 masked individuals, dark jackets">
            </div>

            <div class="col-md-4">
              <label class="form-label" for="witnessDetails">Witness Information</label>
              <input type="text" class="form-control" id="witnessDetails" name="witnessDetails" value="<%= formData.witnessDetails || '' %>" placeholder="e.g. Security Guard A. Sharma, Statement recorded">
            </div>
          </div>

          <!-- Section 5: Reporting Authority -->
          <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
            <span class="badge bg-primary text-white" style="font-size: 11px;">5</span>
            <h6 class="text-uppercase text-dark mb-0 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Investigative Department & Reporting Officer
            </h6>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label" for="reportingInvestigator">Reporting Investigator <span class="text-danger">*</span></label>
              <input type="text" class="form-control <%= errors.reportingInvestigator ? 'is-invalid' : '' %>" id="reportingInvestigator" name="reportingInvestigator" value="<%= formData.reportingInvestigator || '' %>" required>
              <% if (errors.reportingInvestigator) { %><div class="invalid-feedback"><%= errors.reportingInvestigator %></div><% } %>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="department">Department Unit / Squad</label>
              <input type="text" class="form-control" id="department" name="department" value="<%= formData.department || 'Digital Forensics Unit' %>">
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <a href="/cases" class="btn btn-gov-secondary">
              <i class="bi bi-x-circle me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-gov-primary px-4 py-2">
              <i class="bi bi-check2-circle me-1"></i> Ingest & Assign Case Number
            </button>
          </div>

        </form>

      </div>
    </div>

  </main>
</div>

<script>
  function toggleCrimeOther(val) {
    const el = document.getElementById('crimeTypeOtherContainer');
    if (el) {
      if (val === 'Other') el.classList.remove('d-none');
      else el.classList.add('d-none');
    }
  }
</script>

<%- include('../partials/footer') %>
