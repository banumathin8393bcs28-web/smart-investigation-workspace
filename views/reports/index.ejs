<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Forensic Investigation Reports</h1>
        <small class="text-muted">Generate and archive official PDF case reports with cryptographic verification</small>
      </div>
    </div>

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Generate Report Card -->
    <div class="gov-card mb-4 shadow-sm border">
      <div class="gov-card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-plus text-danger me-2"></i> Compile New Investigation PDF Report</h5>
      </div>
      <div class="gov-card-body p-4">
        <form action="/reports/generate" method="POST" class="row g-3 align-items-end">
          <div class="col-md-8">
            <label class="form-label" for="caseId">Select Authorized Investigation Case <span class="text-danger">*</span></label>
            <select class="form-select" id="caseId" name="caseId" required>
              <option value="">Select case to compile...</option>
              <% authorizedCases.forEach(c => { %>
                <option value="<%= c._id %>">
                  <%= c.caseNumber %>: <%= c.caseName %> (<%= c.crimeType %>)
                </option>
              <% }) %>
            </select>
            <small class="text-muted">
              PDF compiles cover details, investigator photograph, crime-scene evidence photos, EXIF metadata, AI detections with bounding overlays, and custody audit history.
            </small>
          </div>
          <div class="col-md-4">
            <button type="submit" class="btn btn-danger w-100 py-2">
              <i class="bi bi-file-earmark-pdf-fill me-1"></i> Generate Forensic PDF Report
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Generated Reports Directory Table -->
    <div class="gov-card">
      <div class="gov-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-archive me-2"></i> Compiled Reports Archive (<%= reports.length %>)</span>
      </div>
      <div class="gov-card-body p-0">
        <% if (reports && reports.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-gov mb-0">
              <thead>
                <tr>
                  <th>Report Identifier</th>
                  <th>Associated Case</th>
                  <th>Generated By</th>
                  <th>File Size</th>
                  <th>PDF SHA-256 Digest</th>
                  <th>Compiled Timestamp</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% reports.forEach(r => { %>
                  <tr>
                    <td>
                      <a href="/reports/view/<%= r._id %>" class="fw-bold text-decoration-none text-danger">
                        <i class="bi bi-file-earmark-pdf me-1"></i> <%= r.reportIdentifier %>
                      </a>
                    </td>
                    <td><strong class="text-primary"><%= r.caseNumber %></strong></td>
                    <td><%= r.generatorName %></td>
                    <td><%= (r.fileSize / 1024).toFixed(1) %> KB</td>
                    <td>
                      <div class="d-flex align-items-center gap-1">
                        <span class="gov-hash text-truncate" style="max-width: 140px;" title="<%= r.pdfSha256Hash %>">
                          <%= r.pdfSha256Hash.substring(0, 16) %>...
                        </span>
                        <button class="btn btn-outline-secondary btn-sm py-0 px-1 btn-copy-hash" data-hash="<%= r.pdfSha256Hash %>" title="Copy Hash">
                          <i class="bi bi-clipboard"></i>
                        </button>
                      </div>
                    </td>
                    <td class="small text-muted"><%= formatTimestamp(r.generationTimestamp) %></td>
                    <td>
                      <div class="d-flex gap-2">
                        <a href="/reports/view/<%= r._id %>" class="btn btn-gov-secondary btn-sm py-1 px-2">
                          <i class="bi bi-eye"></i> View
                        </a>
                        <a href="/reports/download/<%= r._id %>" class="btn btn-danger btn-sm py-1 px-2" download>
                          <i class="bi bi-download"></i> Download PDF
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-5 text-center text-muted">
            <i class="bi bi-file-earmark-x fs-2 mb-2 d-block"></i>
            No reports generated yet. Select a case above to compile an official investigation report.
          </div>
        <% } %>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
