<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Investigation Reports</h1>
        <small class="text-muted">Generate and archive official forensic PDF case reports with cryptographic verification</small>
      </div>
    </div>

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Generate Report Card -->
    <div class="gov-card mb-4 shadow-sm border">
      <div class="gov-card-header bg-white py-3 border-bottom">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-file-earmark-plus text-danger fs-4"></i>
          <div>
            <h5 class="mb-0 fw-bold">Compile New Investigation PDF Report</h5>
            <small class="text-muted">Assembles authoritative case records, officer photograph, digital evidence with SHA-256 digests, and custody history into an official dossier</small>
          </div>
        </div>
      </div>
      <div class="gov-card-body p-4">
        <form action="/reports/generate" method="POST" class="row g-3 align-items-end">
          <div class="col-md-8">
            <label class="form-label" for="caseId">Select Authorized Investigation Case <span class="text-danger">*</span></label>
            <select class="form-select" id="caseId" name="caseId" required>
              <option value="">Select case to compile...</option>
              <% authorizedCases.forEach(c => { %>
                <option value="<%= c._id %>">
                  <%= c.caseNumber %>: <%= c.caseName %> (<%= c.crimeType %>)
                </option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <button type="submit" class="btn btn-danger w-100 py-2">
              <i class="bi bi-file-earmark-pdf-fill me-1"></i> Generate Forensic PDF Report
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Generated Reports Directory Table -->
    <div class="gov-card shadow-sm">
      <div class="gov-card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span><i class="bi bi-archive me-2 text-primary"></i> Generated Forensic Report Archive (<%= reports.length %> Dossiers)</span>
      </div>
      <div class="gov-card-body p-0">
        <% if (reports && reports.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-gov mb-0">
              <thead>
                <tr>
                  <th>Report ID</th>
                  <th>Case #</th>
                  <th>Compiled By</th>
                  <th>Generated (IST)</th>
                  <th>File Size</th>
                  <th>Cryptographic SHA-256</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% reports.forEach(r => { %>
                  <tr>
                    <td>
                      <a href="/reports/view/<%= r._id %>" class="fw-bold font-monospace text-danger text-decoration-none">
                        <%= r.reportIdentifier %>
                      </a>
                    </td>
                    <td>
                      <a href="/cases/<%= r.caseId %>" class="fw-bold font-monospace text-primary text-decoration-none">
                        <%= r.caseNumber %>
                      </a>
                    </td>
                    <td class="fw-semibold"><%= r.generatorName %></td>
                    <td class="small text-muted font-monospace"><%= formatTimestamp(r.generationTimestamp) %></td>
                    <td class="small"><%= (r.fileSize / 1024).toFixed(1) %> KB</td>
                    <td>
                      <div class="d-flex align-items-center gap-1">
                        <span class="gov-hash text-truncate" style="max-width: 140px;" title="<%= r.pdfSha256Hash %>">
                          <%= r.pdfSha256Hash.substring(0, 16) %>...
                        </span>
                        <button class="btn btn-gov-secondary btn-sm py-0 px-1 btn-copy-hash" data-hash="<%= r.pdfSha256Hash %>" title="Copy SHA-256">
                          <i class="bi bi-clipboard"></i>
                        </button>
                      </div>
                    </td>
                    <td class="text-end">
                      <a href="/reports/view/<%= r._id %>" class="btn btn-gov-secondary btn-sm py-1 px-2" title="View Report Metadata">
                        <i class="bi bi-info-circle"></i> Details
                      </a>
                      <a href="/reports/download/<%= r._id %>" class="btn btn-danger btn-sm py-1 px-2 ms-1" download title="Download Signed PDF">
                        <i class="bi bi-download"></i> PDF
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-5 text-center text-muted">
            <i class="bi bi-file-earmark-x fs-2 mb-2 d-block text-secondary"></i>
            No investigation reports have been compiled yet. Select a case above to generate your first PDF dossier.
          </div>
        <% } %>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
