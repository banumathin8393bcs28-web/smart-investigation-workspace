<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="badge bg-danger fs-6"><%= report.reportIdentifier %></span>
          <h1 class="h4 mb-0 fw-bold text-dark">Forensic Investigation Report: <%= caseDoc.caseNumber %></h1>
        </div>
        <small class="text-muted">
          Generated: <%= formatTimestamp(report.generationTimestamp) %> by <%= report.generatorName %> (<%= report.generatorEmail %>)
        </small>
      </div>
      <div class="d-flex gap-2">
        <a href="/reports" class="btn btn-gov-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Reports Directory
        </a>
        <a href="/reports/download/<%= report._id %>" class="btn btn-danger btn-sm" download>
          <i class="bi bi-download me-1"></i> Download Verified PDF
        </a>
      </div>
    </div>

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="row g-4">
      <div class="col-lg-5">
        <!-- Report Metadata Card -->
        <div class="gov-card mb-4">
          <div class="gov-card-header">
            <span><i class="bi bi-info-circle me-2"></i> Report Specification Details</span>
          </div>
          <div class="gov-card-body p-0">
            <table class="table table-gov table-sm mb-0">
              <tbody>
                <tr>
                  <th style="width: 45%;">Report Identifier:</th>
                  <td class="fw-bold text-danger"><%= report.reportIdentifier %></td>
                </tr>
                <tr>
                  <th>Target Case:</th>
                  <td>
                    <a href="/cases/<%= caseDoc._id %>" class="fw-bold text-primary text-decoration-none">
                      <%= caseDoc.caseNumber %> - <%= caseDoc.caseName %>
                    </a>
                  </td>
                </tr>
                <tr>
                  <th>Compiled By:</th>
                  <td><%= report.generatorName %></td>
                </tr>
                <tr>
                  <th>Generator Email:</th>
                  <td><%= report.generatorEmail %></td>
                </tr>
                <tr>
                  <th>Compilation Timestamp:</th>
                  <td class="small"><%= formatTimestamp(report.generationTimestamp) %></td>
                </tr>
                <tr>
                  <th>PDF File Size:</th>
                  <td><%= (report.fileSize / 1024).toFixed(1) %> KB</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- PDF Cryptographic SHA-256 Card -->
        <div class="gov-card border-success">
          <div class="gov-card-header bg-success text-white">
            <span><i class="bi bi-shield-check me-2"></i> PDF Cryptographic Digest</span>
          </div>
          <div class="gov-card-body p-3">
            <label class="form-label small text-muted mb-1">Generated Document SHA-256 Digest:</label>
            <div class="d-flex align-items-center gap-2 mb-2">
              <input type="text" class="form-control form-control-sm font-monospace text-dark bg-light fw-bold" value="<%= report.pdfSha256Hash %>" readonly>
              <button class="btn btn-gov-secondary btn-sm btn-copy-hash" data-hash="<%= report.pdfSha256Hash %>">
                <i class="bi bi-clipboard"></i>
              </button>
            </div>
            <small class="text-muted" style="font-size: 11px;">
              This digest authenticates the compiled PDF file against post-generation alteration or unauthorized tampering.
            </small>
          </div>
        </div>
      </div>

      <div class="col-lg-7">
        <!-- PDF Preview Action Box -->
        <div class="gov-card text-center p-5 shadow-sm">
          <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 4rem;"></i>
          <h4 class="mt-3 fw-bold text-dark"><%= report.reportIdentifier %>_<%= report.caseNumber %>.pdf</h4>
          <p class="text-muted small mb-4" style="max-width: 450px; margin: 0 auto;">
            This certified investigation dossier contains complete incident specifications, officer verification, evidence items with SHA-256 digests, computer vision YOLOv8 bounding annotations, and chronological custody trails.
          </p>

          <div class="d-flex justify-content-center gap-3">
            <a href="/reports/download/<%= report._id %>" class="btn btn-danger btn-lg px-4" download>
              <i class="bi bi-download me-2"></i> Download Official PDF
            </a>
            <a href="/cases/<%= caseDoc._id %>" class="btn btn-gov-secondary btn-lg px-4">
              <i class="bi bi-folder2-open me-2"></i> Return to Case
            </a>
          </div>

          <div class="mt-4 pt-3 border-top">
            <small class="text-muted fst-italic">
              Official application record. Generated automatically from database records; does not independently establish court admissibility.
            </small>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
