<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
          <span class="badge bg-danger font-monospace fs-6 px-2 py-1"><%= report.reportIdentifier %></span>
          <h1 class="h4 mb-0 fw-bold text-dark">Forensic Investigation Report: <%= caseDoc.caseNumber %></h1>
        </div>
        <small class="text-muted d-flex flex-wrap align-items-center gap-2">
          <span>Target Case: <a href="/cases/<%= caseDoc._id %>" class="text-primary fw-semibold"><%= caseDoc.caseName %></a></span>
          <span>&bull;</span>
          <span class="font-monospace">Generated: <%= formatTimestamp(report.generationTimestamp) %> by <%= report.generatorName %></span>
        </small>
      </div>
      <div class="d-flex gap-2">
        <a href="/reports" class="btn btn-gov-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Reports Directory
        </a>
        <a href="/reports/download/<%= report._id %>" class="btn btn-danger btn-sm" download>
          <i class="bi bi-download me-1"></i> Download Verified PDF
        </a>
      </div>
    </div>

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="row g-4">
      <div class="col-lg-5">
        <!-- Report Metadata Card -->
        <div class="gov-card shadow-sm mb-4">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-info-circle text-primary me-2"></i> Report Specification Details</span>
          </div>
          <div class="gov-card-body p-0">
            <table class="table table-gov table-sm mb-0">
              <tbody>
                <tr>
                  <th style="width: 45%;">Report Identifier:</th>
                  <td class="fw-bold font-monospace text-danger"><%= report.reportIdentifier %></td>
                </tr>
                <tr>
                  <th>Target Case:</th>
                  <td>
                    <a href="/cases/<%= caseDoc._id %>" class="fw-bold text-primary text-decoration-none font-monospace">
                      <%= caseDoc.caseNumber %>
                    </a>
                    <span class="text-muted small">&bull; <%= caseDoc.caseName %></span>
                  </td>
                </tr>
                <tr>
                  <th>Compiled By:</th>
                  <td class="fw-semibold"><%= report.generatorName %></td>
                </tr>
                <tr>
                  <th>Generator Email:</th>
                  <td class="small font-monospace"><%= report.generatorEmail %></td>
                </tr>
                <tr>
                  <th>Compilation (IST):</th>
                  <td class="small font-monospace"><%= formatTimestamp(report.generationTimestamp) %></td>
                </tr>
                <tr>
                  <th>PDF File Size:</th>
                  <td><%= (report.fileSize / 1024).toFixed(1) %> KB (<%= report.fileSize %> bytes)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- PDF Cryptographic SHA-256 Card -->
        <div class="gov-card shadow-sm border-success mb-0">
          <div class="gov-card-header bg-white py-3 border-bottom text-success fw-bold">
            <span><i class="bi bi-shield-check me-2"></i> PDF Cryptographic Digest</span>
          </div>
          <div class="gov-card-body p-4">
            <label class="form-label small text-muted mb-1 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">Document SHA-256 Digest:</label>
            <div class="d-flex align-items-center gap-2 mb-2">
              <input type="text" class="form-control form-control-sm font-monospace text-dark bg-light fw-bold" value="<%= report.pdfSha256Hash %>" readonly>
              <button class="btn btn-gov-secondary btn-sm btn-copy-hash" data-hash="<%= report.pdfSha256Hash %>" title="Copy Hash">
                <i class="bi bi-clipboard"></i>
              </button>
            </div>
            <small class="text-muted" style="font-size: 11px; line-height: 1.4;">
              This digest authenticates the compiled PDF file against post-generation alteration or unauthorized tampering in legal proceedings.
            </small>
          </div>
        </div>
      </div>

      <div class="col-lg-7">
        <!-- PDF Preview Action Box -->
        <div class="gov-card shadow-sm text-center p-5 mb-0 h-100 d-flex flex-column justify-content-center align-items-center">
          <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px; background: #fee2e2; border-radius: 50%; color: #dc2626; font-size: 2.2rem;">
            <i class="bi bi-file-earmark-pdf-fill"></i>
          </div>
          <h4 class="fw-bold text-dark mb-1">Official Forensic Case Dossier</h4>
          <p class="text-muted small mb-4" style="max-width: 420px; line-height: 1.5;">
            Document compiled with official departmental header, investigator credentials, digital evidence photographs, EXIF metadata, AI YOLOv8 detection overlays, and chronological custody history.
          </p>

          <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="/reports/download/<%= report._id %>" class="btn btn-danger btn-lg px-4" download>
              <i class="bi bi-download me-1"></i> Download Authenticated PDF
            </a>
            <a href="/cases/<%= caseDoc._id %>" class="btn btn-gov-secondary btn-lg px-4">
              <i class="bi bi-folder2-open me-1"></i> Return to Case
            </a>
          </div>
        </div>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
