<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content d-flex flex-column" style="height: calc(100vh - var(--gov-topbar-height) - 45px); overflow: hidden;">

    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-shrink-0">
      <div>
        <h1 class="h4 mb-0 fw-bold text-dark">Investigator Communication</h1>
        <small class="text-muted">Encrypted, authenticated real-time channel between authorized investigators</small>
      </div>
      <a href="/contacts/add" class="btn btn-gov-secondary btn-sm">
        <i class="bi bi-person-plus me-1"></i> Add Contact
      </a>
    </div>

    <!-- Chat Workstation: Left Contacts Drawer + Right Conversation Stream -->
    <div class="gov-card flex-grow-1 d-flex flex-row overflow-hidden mb-0 shadow-sm border">

      <!-- Left Contacts Drawer (Width 280px) -->
      <div class="border-end d-flex flex-column bg-white flex-shrink-0" style="width: 280px;">
        <div class="p-3 border-bottom bg-light fw-bold small text-muted text-uppercase d-flex justify-content-between align-items-center" style="font-size: 11px; letter-spacing: 0.5px;">
          <span>Contacts Directory</span>
          <span class="badge bg-secondary-subtle text-secondary border"><%= contacts.length %></span>
        </div>
        <div class="list-group list-group-flush overflow-y-auto flex-grow-1">
          <% if (contacts && contacts.length > 0) { %>
            <% contacts.forEach(c => { %>
              <%
                const isActive = activeRecipient && activeRecipient._id.toString() === c.contact._id.toString();
              %>
              <a href="/messages?recipientId=<%= c.contact._id %>" class="list-group-item list-group-item-action p-3 <%= isActive ? 'bg-light border-start border-3 border-primary' : '' %>">
                <div class="d-flex align-items-center gap-2">
                  <div class="position-relative">
                    <img src="<%= c.contact.profilePhoto || '/images/default-avatar.png' %>" alt="Photo" class="gov-avatar-sm" style="width: 34px; height: 34px;">
                    <span class="position-absolute bottom-0 end-0 p-1 bg-<%= c.isOnline ? 'success' : 'secondary' %> border border-white rounded-circle" style="width: 10px; height: 10px;"></span>
                  </div>
                  <div class="overflow-hidden flex-grow-1">
                    <div class="d-flex justify-content-between align-items-baseline">
                      <strong class="text-truncate text-dark small"><%= c.displayName || c.contact.fullName %></strong>
                    </div>
                    <div class="text-muted text-truncate" style="font-size: 11px;"><%= c.contact.role %></div>
                  </div>
                </div>
              </a>
            <% }) %>
          <% } else { %>
            <div class="p-4 text-muted text-center small">
              No contacts yet.<br><a href="/contacts/add" class="fw-semibold">Connect with colleagues &rarr;</a>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right Conversation Drawer -->
      <div class="d-flex flex-column flex-grow-1 bg-light">

        <% if (activeRecipient) { %>
          <!-- Conversation Header -->
          <div class="p-3 px-4 border-bottom bg-white d-flex justify-content-between align-items-center flex-shrink-0">
            <div class="d-flex align-items-center gap-3">
              <img src="<%= activeRecipient.profilePhoto || '/images/default-avatar.png' %>" alt="Photo" class="gov-avatar-sm" style="width: 38px; height: 38px;">
              <div>
                <h6 class="mb-0 fw-bold text-dark"><%= activeRecipient.fullName %></h6>
                <div class="text-muted small" style="font-size: 11px;">
                  <%= activeRecipient.role %> &bull; <span class="font-monospace"><%= activeRecipient.email %></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Messages Stream Scroll Container -->
          <div class="flex-grow-1 p-4 overflow-y-auto d-flex flex-column gap-3" id="messageStream">
            <% if (messages && messages.length > 0) { %>
              <% messages.forEach(m => { %>
                <%
                  const isMine = m.sender.toString() === currentInvestigator._id.toString();
                  const senderPhoto = isMine ? (currentInvestigator.profilePhoto || '/images/default-avatar.png') : (activeRecipient.profilePhoto || '/images/default-avatar.png');
                  const senderName = isMine ? currentInvestigator.fullName : activeRecipient.fullName;
                %>
                <div class="d-flex <%= isMine ? 'justify-content-end' : 'justify-content-start' %> gap-2 align-items-end">
                  <% if (!isMine) { %>
                    <img src="<%= senderPhoto %>" alt="<%= senderName %>" class="gov-avatar-sm rounded-circle border flex-shrink-0" style="width: 28px; height: 28px; object-fit: cover;" title="<%= senderName %>">
                  <% } %>

                  <div class="d-flex flex-column <%= isMine ? 'align-items-end' : 'align-items-start' %>" style="max-width: 70%;">
                    <div class="p-3 rounded shadow-sm <%= isMine ? 'text-white' : 'bg-white text-dark border' %>" style="<%= isMine ? 'background-color: #0f2a4a;' : '' %>">
                      <% if (m.messageText) { %>
                        <div class="mb-1" style="font-size: 0.92rem; line-height: 1.5;"><%= m.messageText %></div>
                      <% } %>

                      <% if (m.attachments && m.attachments.length > 0) { %>
                        <div class="<%= m.messageText ? 'mt-2 pt-2 border-top border-opacity-25' : '' %> <%= isMine ? 'border-white' : 'border-secondary' %>">
                          <% m.attachments.forEach((att, attIdx) => { %>
                            <% 
                              const isImg = (att.mimeType && att.mimeType.startsWith('image/')) || (att.originalName && att.originalName.match(/\.(jpg|jpeg|png|webp|gif)$/i));
                              const fileSrc = att.cloudinaryUrl && att.cloudinaryUrl.startsWith('http') ? att.cloudinaryUrl : ('/messages/attachment/' + m._id + '/' + attIdx);
                            %>
                            <% if (isImg) { %>
                              <div class="mb-2">
                                <a href="<%= fileSrc %>" target="_blank" title="View Full Image">
                                  <img src="<%= fileSrc %>" alt="<%= att.originalName %>" class="img-fluid rounded border shadow-sm" style="max-height: 220px; max-width: 100%; object-fit: contain; background: rgba(0,0,0,0.05); display: block;" onerror="this.style.display='none';">
                                </a>
                              </div>
                            <% } %>
                            <a href="/messages/attachment/<%= m._id %>/<%= attIdx %>" class="btn btn-sm <%= isMine ? 'btn-outline-light' : 'btn-gov-secondary' %> py-1 px-2 mb-1" download>
                              <i class="bi <%= isImg ? 'bi-image' : 'bi-paperclip' %> me-1"></i> <%= att.originalName || att.originalFilename || 'Attachment' %>
                              <span class="opacity-75 small">(<%= (att.size / 1024).toFixed(0) %> KB)</span>
                            </a>
                          <% }) %>
                        </div>
                      <% } %>
                    </div>
                    <small class="text-muted mt-1 font-monospace" style="font-size: 10px;">
                      <%= formatTimestamp(m.sentTimestamp, { includeSeconds: false }) %>
                      <% if (isMine) { %> &bull; <i class="bi bi-check2"></i> Sent<% } %>
                    </small>
                  </div>

                  <% if (isMine) { %>
                    <img src="<%= senderPhoto %>" alt="<%= senderName %>" class="gov-avatar-sm rounded-circle border flex-shrink-0" style="width: 28px; height: 28px; object-fit: cover;" title="<%= senderName %>">
                  <% } %>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-center text-muted my-auto p-4">
                <i class="bi bi-chat-dots fs-1 mb-2 d-block text-secondary"></i>
                Channel established. Send a secure encrypted message to start collaborating.
              </div>
            <% } %>
          </div>

          <!-- Message Input Toolbar -->
          <div class="p-3 bg-white border-top flex-shrink-0">
            <!-- File attachment preview container -->
            <div id="attachmentPreview" class="d-none mb-2 p-2 bg-light rounded border align-items-center justify-content-between">
              <div class="d-flex align-items-center gap-2 overflow-hidden">
                <img id="attachmentThumbnail" src="" alt="preview" class="rounded border d-none" style="width: 44px; height: 44px; object-fit: cover;">
                <i id="attachmentFileIcon" class="bi bi-paperclip fs-4 text-primary"></i>
                <div class="text-truncate small">
                  <strong id="attachmentFileName" class="text-dark d-block text-truncate"></strong>
                  <span id="attachmentFileSize" class="text-muted" style="font-size: 11px;"></span>
                </div>
              </div>
              <button type="button" id="removeAttachmentBtn" class="btn btn-sm btn-outline-danger py-0 px-2" title="Remove attachment">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>

            <form action="/messages/send" method="POST" enctype="multipart/form-data" id="chatForm" class="d-flex align-items-center gap-2">
              <input type="hidden" name="recipientId" value="<%= activeRecipient._id %>">

              <label class="btn btn-gov-secondary btn-sm mb-0 px-3 py-2" id="attachBtn" title="Attach Evidence File or Photo" style="cursor: pointer;">
                <i class="bi bi-paperclip"></i>
                <input type="file" id="attachmentInput" name="attachment" class="d-none" accept="image/*,.pdf,.doc,.docx,.txt">
              </label>

              <input type="text" class="form-control" id="messageTextInput" name="messageText" placeholder="Type a message or select an image to attach..." autofocus autocomplete="off">

              <button type="submit" class="btn btn-gov-primary px-4 py-2" id="sendBtn">
                <i class="bi bi-send-fill me-1"></i> Send
              </button>
            </form>
          </div>

        <% } else { %>
          <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted p-5 text-center">
            <i class="bi bi-chat-square-text fs-1 mb-2 text-secondary"></i>
            <h5>Select a Colleague from the Directory</h5>
            <p class="small text-muted mb-0">Choose an active contact from the left drawer to inspect conversational logs and dispatch real-time directives.</p>
          </div>
        <% } %>

      </div>

    </div>

  </main>
</div>

<script>
  // Auto-scroll message stream to bottom on load
  const stream = document.getElementById('messageStream');
  if (stream) {
    stream.scrollTop = stream.scrollHeight;
  }

  // Handle attachment selection & preview
  const fileInput = document.getElementById('attachmentInput');
  const previewBox = document.getElementById('attachmentPreview');
  const fileNameEl = document.getElementById('attachmentFileName');
  const fileSizeEl = document.getElementById('attachmentFileSize');
  const thumbEl = document.getElementById('attachmentThumbnail');
  const iconEl = document.getElementById('attachmentFileIcon');
  const removeBtn = document.getElementById('removeAttachmentBtn');
  const chatForm = document.getElementById('chatForm');
  const messageInput = document.getElementById('messageTextInput');
  const attachBtn = document.getElementById('attachBtn');

  if (fileInput) {
    fileInput.addEventListener('change', function () {
      if (this.files && this.files[0]) {
        const file = this.files[0];
        fileNameEl.textContent = file.name;
        fileSizeEl.textContent = (file.size / 1024).toFixed(1) + ' KB';
        previewBox.classList.remove('d-none');
        previewBox.classList.add('d-flex');
        if (attachBtn) {
          attachBtn.classList.add('btn-primary');
          attachBtn.classList.remove('btn-gov-secondary');
        }

        if (file.type && file.type.startsWith('image/')) {
          const reader = new FileReader();
          reader.onload = function (e) {
            thumbEl.src = e.target.result;
            thumbEl.classList.remove('d-none');
            iconEl.classList.add('d-none');
          };
          reader.readAsDataURL(file);
        } else {
          thumbEl.classList.add('d-none');
          iconEl.classList.remove('d-none');
        }

        if (messageInput) {
          messageInput.focus();
        }
      }
    });
  }

  if (removeBtn) {
    removeBtn.addEventListener('click', function () {
      if (fileInput) fileInput.value = '';
      previewBox.classList.add('d-none');
      previewBox.classList.remove('d-flex');
      thumbEl.src = '';
      if (attachBtn) {
        attachBtn.classList.remove('btn-primary');
        attachBtn.classList.add('btn-gov-secondary');
      }
    });
  }

  if (chatForm) {
    chatForm.addEventListener('submit', function (e) {
      const hasText = messageInput && messageInput.value.trim().length > 0;
      const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;
      if (!hasText && !hasFile) {
        e.preventDefault();
        if (messageInput) messageInput.focus();
        return false;
      }
    });
  }
</script>

<%- include('../partials/footer') %>
