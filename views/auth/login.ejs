<%- include('../partials/header') %>

<div class="container py-5 my-auto">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">

      <!-- Success & General Flash Messages -->
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (errors.general) { %>
        <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errors.general %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Login Card -->
      <div class="gov-card shadow-sm border">
        <div class="gov-card-header bg-white py-3 border-bottom">
          <div class="d-flex align-items-center gap-3">
            <div class="gov-brand-icon" style="width: 36px; height: 36px; font-size: 1.1rem;">
              <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
              <h2 class="h5 mb-0 fw-bold text-dark">Investigator Login</h2>
              <small class="text-muted">Secure Forensic Workstation Access</small>
            </div>
          </div>
        </div>

        <div class="gov-card-body p-4">

          <form action="/auth/login" method="POST" novalidate>

            <!-- Official Government Email -->
            <div class="mb-3">
              <label class="form-label" for="email">Official Government Email <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" class="form-control <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" value="<%= emailValue || '' %>" placeholder="name.unit@gov.in" required autofocus>
                <% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %>
              </div>
              <small class="text-muted" style="font-size: 11px;">Format requirement: <code>xxx.yyy@gov.in</code></small>
            </div>

            <!-- Password with Show/Hide -->
            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label mb-0" for="password">Password <span class="text-danger">*</span></label>
                <a href="/auth/forgot-password" class="text-decoration-none small text-muted">Forgot Password?</a>
              </div>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-key"></i></span>
                <input type="password" class="form-control <%= errors.password ? 'is-invalid' : '' %>" id="password" name="password" placeholder="Enter password" required>
                <button class="btn btn-outline-secondary toggle-password-btn" type="button" data-target="password" title="Toggle password visibility">
                  <i class="bi bi-eye"></i> Show
                </button>
                <% if (errors.password) { %><div class="invalid-feedback"><%= errors.password %></div><% } %>
              </div>
            </div>

            <!-- Consecutive Failed Login Security Challenge -->
            <% if (requireSecurityQuestion) { %>
              <div class="p-3 mb-3 border rounded bg-warning-subtle border-warning">
                <div class="fw-bold text-dark small mb-1">
                  <i class="bi bi-shield-exclamation text-warning me-1"></i> Secondary Security Challenge Required
                </div>
                <div class="text-muted small mb-2">
                  Multiple consecutive failed password attempts detected. Please answer your registered security question:
                </div>
                <div class="fw-semibold text-dark mb-2 p-2 bg-white rounded border">
                  "<%= securityQuestionText %>"
                </div>
                <label class="form-label small" for="securityAnswer">One-Word Answer <span class="text-danger">*</span></label>
                <input type="text" class="form-control <%= errors.securityAnswer ? 'is-invalid' : '' %>" id="securityAnswer" name="securityAnswer" placeholder="Enter one-word answer" required>
                <% if (errors.securityAnswer) { %><div class="invalid-feedback d-block"><%= errors.securityAnswer %></div><% } %>
              </div>
            <% } %>

            <!-- Server-Side CAPTCHA -->
            <div class="mb-4">
              <label class="form-label" for="captcha">Server-Side CAPTCHA <span class="text-danger">*</span></label>
              <div class="row g-2 align-items-center">
                <div class="col-7">
                  <input type="text" class="form-control <%= errors.captcha ? 'is-invalid' : '' %>" id="captcha" name="captcha" placeholder="Enter characters" required autocomplete="off">
                  <% if (errors.captcha) { %><div class="invalid-feedback"><%= errors.captcha %></div><% } %>
                </div>
                <div class="col-5 d-flex align-items-center gap-1">
                  <div class="border rounded p-1 bg-light flex-grow-1 text-center" style="overflow: hidden;">
                    <span id="captchaContainer"><%- captchaSvg %></span>
                  </div>
                  <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-2" onclick="refreshCaptcha()" title="Refresh CAPTCHA">
                    <i class="bi bi-arrow-clockwise"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-gov-primary py-2">
                <i class="bi bi-box-arrow-in-right me-1"></i> Authenticate & Enter
              </button>
            </div>

            <div class="text-center pt-3 border-top">
              <small class="text-muted">
                New investigator? <a href="/auth/register" class="fw-semibold text-primary">Register Official Account</a>
              </small>
            </div>

          </form>

        </div>
      </div>

      <div class="text-center mt-3">
        <a href="/" class="text-muted small text-decoration-none">
          <i class="bi bi-arrow-left me-1"></i> Back to Workspace Welcome Page
        </a>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
