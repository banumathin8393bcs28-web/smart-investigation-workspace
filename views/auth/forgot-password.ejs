<%- include('../partials/header') %>

<div class="container py-5 my-auto">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">

      <div class="gov-card shadow-sm border">
        <div class="gov-card-header bg-white py-3">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-shield-lock text-primary fs-4"></i>
            <div>
              <h2 class="h5 mb-0 fw-bold">Reset Password</h2>
              <small class="text-muted">Security Question Verification</small>
            </div>
          </div>
        </div>

        <div class="gov-card-body p-4">

          <% if (step === 1) { %>
            <form action="/auth/forgot-password/step1" method="POST">
              <p class="text-muted small mb-3">
                Enter your official government email to initiate credential verification.
              </p>

              <div class="mb-3">
                <label class="form-label" for="email">Official Government Email <span class="text-danger">*</span></label>
                <input type="email" class="form-control <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" value="<%= email || '' %>" placeholder="name.unit@gov.in" required>
                <% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %>
              </div>

              <!-- CAPTCHA -->
              <div class="mb-4">
                <label class="form-label" for="captcha">CAPTCHA Verification <span class="text-danger">*</span></label>
                <div class="row g-2 align-items-center">
                  <div class="col-7">
                    <input type="text" class="form-control <%= errors.captcha ? 'is-invalid' : '' %>" id="captcha" name="captcha" required>
                    <% if (errors.captcha) { %><div class="invalid-feedback"><%= errors.captcha %></div><% } %>
                  </div>
                  <div class="col-5 d-flex align-items-center gap-2">
                    <div class="border rounded p-1 bg-light text-center flex-grow-1"><%- captchaSvg %></div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i></button>
                  </div>
                </div>
              </div>

              <div class="d-grid mb-3">
                <button type="submit" class="btn btn-gov-primary py-2">Continue Verification</button>
              </div>
            </form>
          <% } else { %>
            <!-- Step 2: Answer question and enter new password -->
            <form action="/auth/forgot-password/step2" method="POST">
              <div class="alert alert-info py-2 mb-3 small">
                <strong>Verifying Account:</strong> <%= email %>
              </div>

              <div class="mb-3">
                <label class="form-label">Registered Security Question</label>
                <div class="p-2 border rounded bg-light fw-semibold text-dark small mb-2">
                  <%= securityQuestionText %>
                </div>
                <label class="form-label" for="securityAnswer">One-Word Answer <span class="text-danger">*</span></label>
                <input type="text" class="form-control <%= errors.securityAnswer ? 'is-invalid' : '' %>" id="securityAnswer" name="securityAnswer" placeholder="Enter answer" required>
                <% if (errors.securityAnswer) { %><div class="invalid-feedback"><%= errors.securityAnswer %></div><% } %>
              </div>

              <div class="mb-3">
                <label class="form-label" for="newPassword">New Password <span class="text-danger">*</span></label>
                <input type="password" class="form-control <%= errors.newPassword ? 'is-invalid' : '' %>" id="newPassword" name="newPassword" required>
                <% if (errors.newPassword) { %><div class="invalid-feedback"><%= errors.newPassword %></div><% } %>
              </div>

              <div class="mb-3">
                <label class="form-label" for="retypePassword">Retype New Password <span class="text-danger">*</span></label>
                <input type="password" class="form-control <%= errors.retypePassword ? 'is-invalid' : '' %>" id="retypePassword" name="retypePassword" required>
                <% if (errors.retypePassword) { %><div class="invalid-feedback"><%= errors.retypePassword %></div><% } %>
              </div>

              <!-- CAPTCHA -->
              <div class="mb-4">
                <label class="form-label" for="captcha">CAPTCHA Verification <span class="text-danger">*</span></label>
                <div class="row g-2 align-items-center">
                  <div class="col-7">
                    <input type="text" class="form-control <%= errors.captcha ? 'is-invalid' : '' %>" id="captcha" name="captcha" required>
                    <% if (errors.captcha) { %><div class="invalid-feedback"><%= errors.captcha %></div><% } %>
                  </div>
                  <div class="col-5 d-flex align-items-center gap-2">
                    <div class="border rounded p-1 bg-light text-center flex-grow-1"><%- captchaSvg %></div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i></button>
                  </div>
                </div>
              </div>

              <div class="d-grid mb-3">
                <button type="submit" class="btn btn-gov-primary py-2">Set New Password & Complete</button>
              </div>
            </form>
          <% } %>

          <div class="text-center pt-2 border-top">
            <a href="/auth/login" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Login</a>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
