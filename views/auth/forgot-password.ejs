<%- include('../partials/header') %>

<div class="container py-5 my-auto">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">

      <div class="gov-card shadow-sm border">
        <div class="gov-card-header bg-white py-3 border-bottom">
          <div class="d-flex align-items-center gap-3">
            <div class="gov-brand-icon" style="width: 36px; height: 36px; font-size: 1.1rem;">
              <i class="bi bi-shield-lock"></i>
            </div>
            <div>
              <h2 class="h5 mb-0 fw-bold text-dark">Reset Password</h2>
              <small class="text-muted">Security Question Verification Protocol</small>
            </div>
          </div>
        </div>

        <div class="gov-card-body p-4">

          <% if (step === 1) { %>
            <form action="/auth/forgot-password/step1" method="POST">
              <p class="text-muted small mb-3">
                Enter your official government email to initiate credential verification.
              </p>

              <div class="mb-3">
                <label class="form-label" for="email">Official Government Email <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                  <input type="email" class="form-control <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" value="<%= email || '' %>" placeholder="name.unit@gov.in" required autofocus>
                  <% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %>
                </div>
              </div>

              <!-- CAPTCHA -->
              <div class="mb-4">
                <label class="form-label" for="captcha">CAPTCHA Verification <span class="text-danger">*</span></label>
                <div class="row g-2 align-items-center">
                  <div class="col-7">
                    <input type="text" class="form-control <%= errors.captcha ? 'is-invalid' : '' %>" id="captcha" name="captcha" placeholder="Enter characters" required autocomplete="off">
                    <% if (errors.captcha) { %><div class="invalid-feedback"><%= errors.captcha %></div><% } %>
                  </div>
                  <div class="col-5 d-flex align-items-center gap-1">
                    <div class="border rounded p-1 bg-light text-center flex-grow-1" style="overflow: hidden;">
                      <span id="captchaContainer"><%- captchaSvg %></span>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-2" onclick="refreshCaptcha()" title="Refresh CAPTCHA">
                      <i class="bi bi-arrow-clockwise"></i>
                    </button>
                  </div>
                </div>
              </div>

              <div class="d-grid mb-3">
                <button type="submit" class="btn btn-gov-primary py-2">
                  <i class="bi bi-arrow-right-circle me-1"></i> Continue Verification
                </button>
              </div>

              <div class="text-center pt-2 border-top">
                <a href="/auth/login" class="text-decoration-none small text-muted">
                  <i class="bi bi-arrow-left me-1"></i> Return to Login
                </a>
              </div>
            </form>
          <% } else { %>
            <!-- Step 2: Answer question and enter new password -->
            <form action="/auth/forgot-password/step2" method="POST">
              <div class="alert alert-info alert-gov py-2 mb-3 small">
                <i class="bi bi-info-circle me-1"></i> <strong>Verifying Account:</strong> <%= email %>
              </div>

              <div class="mb-3">
                <label class="form-label">Registered Security Question</label>
                <div class="p-2 border rounded bg-light fw-semibold text-dark small mb-2">
                  "<%= securityQuestionText %>"
                </div>
                <label class="form-label" for="securityAnswer">One-Word Answer <span class="text-danger">*</span></label>
                <input type="text" class="form-control <%= errors.securityAnswer ? 'is-invalid' : '' %>" id="securityAnswer" name="securityAnswer" placeholder="Enter one-word answer" required autofocus>
                <% if (errors.securityAnswer) { %><div class="invalid-feedback"><%= errors.securityAnswer %></div><% } %>
              </div>

              <div class="mb-3">
                <label class="form-label" for="newPassword">New Password <span class="text-danger">*</span></label>
                <div class="input-group">
                  <input type="password" class="form-control <%= errors.newPassword ? 'is-invalid' : '' %>" id="newPassword" name="newPassword" required>
                  <button class="btn btn-outline-secondary toggle-password-btn" type="button" data-target="newPassword">
                    <i class="bi bi-eye"></i> Show
                  </button>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label" for="retypePassword">Retype New Password <span class="text-danger">*</span></label>
                <div class="input-group">
                  <input type="password" class="form-control <%= errors.retypePassword ? 'is-invalid' : '' %>" id="retypePassword" name="retypePassword" required>
                  <button class="btn btn-outline-secondary toggle-password-btn" type="button" data-target="retypePassword">
                    <i class="bi bi-eye"></i> Show
                  </button>
                  <% if (errors.retypePassword) { %><div class="invalid-feedback"><%= errors.retypePassword %></div><% } %>
                </div>
              </div>

              <!-- CAPTCHA -->
              <div class="mb-4">
                <label class="form-label" for="captcha">Security CAPTCHA <span class="text-danger">*</span></label>
                <div class="row g-2 align-items-center">
                  <div class="col-7">
                    <input type="text" class="form-control <%= errors.captcha ? 'is-invalid' : '' %>" id="captcha" name="captcha" placeholder="Enter characters" required autocomplete="off">
                    <% if (errors.captcha) { %><div class="invalid-feedback"><%= errors.captcha %></div><% } %>
                  </div>
                  <div class="col-5 d-flex align-items-center gap-1">
                    <div class="border rounded p-1 bg-light text-center flex-grow-1" style="overflow: hidden;">
                      <span id="captchaContainer"><%- captchaSvg %></span>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-2" onclick="refreshCaptcha()" title="Refresh CAPTCHA">
                      <i class="bi bi-arrow-clockwise"></i>
                    </button>
                  </div>
                </div>
              </div>

              <div class="d-grid mb-3">
                <button type="submit" class="btn btn-gov-primary py-2">
                  <i class="bi bi-check2-circle me-1"></i> Update Password & Re-authenticate
                </button>
              </div>

              <div class="text-center pt-2 border-top">
                <a href="/auth/login" class="text-decoration-none small text-muted">
                  <i class="bi bi-arrow-left me-1"></i> Cancel and Return to Login
                </a>
              </div>
            </form>
          <% } %>

        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
