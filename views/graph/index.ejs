<%- include('../partials/header') %>

<!-- Top Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h1 class="mb-1"><i class="bi bi-diagram-3 text-info"></i> Pictorial Relationship Knowledge Graph</h1>
    <p class="text-muted fs-5 mb-0">Multi-entity relational mapping connecting cases, suspects, evidence, investigators, locations, and AI findings.</p>
  </div>
  
  <div class="d-flex align-items-center gap-2">
    <!-- Filter by Case -->
    <form action="/graph" method="GET" class="d-flex align-items-center gap-2">
      <select class="form-select" name="caseId" onchange="this.form.submit()">
        <option value="all" <%= selectedCaseId === 'all' ? 'selected' : '' %>>Entire Bureau Network (All Cases)</option>
        <% cases.forEach(c => { %>
          <option value="<%= c._id %>" <%= selectedCaseId === c._id.toString() ? 'selected' : '' %>>
            <%= c.caseNumber %> - <%= c.title %>
          </option>
        <% }); %>
      </select>
    </form>
  </div>
</div>

<!-- Graph Legend & Controls Bar -->
<div class="forensic-card p-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
  <!-- Legend -->
  <div class="d-flex flex-wrap align-items-center gap-3">
    <span class="text-muted small fw-bold text-uppercase">Legend:</span>
    <span class="badge" style="background-color: #2563eb; color: #fff;"><i class="bi bi-folder2"></i> Case</span>
    <span class="badge" style="background-color: #dc2626; color: #fff;"><i class="bi bi-person"></i> Suspect</span>
    <span class="badge" style="background-color: #d97706; color: #fff;"><i class="bi bi-camera-reels"></i> Evidence</span>
    <span class="badge" style="background-color: #7c3aed; color: #fff;"><i class="bi bi-shield"></i> Investigator</span>
    <span class="badge" style="background-color: #059669; color: #fff;"><i class="bi bi-geo-alt"></i> Location</span>
    <span class="badge" style="background-color: #0891b2; color: #fff;"><i class="bi bi-search"></i> Finding</span>
  </div>

  <!-- Zoom & Layout Controls -->
  <div class="d-flex gap-2">
    <button class="btn btn-sm btn-outline" id="btn-zoom-in" title="Zoom In"><i class="bi bi-zoom-in"></i></button>
    <button class="btn btn-sm btn-outline" id="btn-zoom-out" title="Zoom Out"><i class="bi bi-zoom-out"></i></button>
    <button class="btn btn-sm btn-outline" id="btn-fit-graph" title="Fit to Screen"><i class="bi bi-arrows-fullscreen"></i></button>
    <button class="btn btn-sm btn-primary" id="btn-re-layout" title="Rearrange Force Layout"><i class="bi bi-arrow-repeat"></i> Rearrange</button>
  </div>
</div>

<div class="row g-4">
  <!-- Main Cytoscape Canvas -->
  <div class="col-lg-9">
    <div id="cy-container"></div>
  </div>

  <!-- Right Inspector Panel -->
  <div class="col-lg-3">
    <div id="graph-inspector">
      <div class="forensic-card text-center py-5 text-muted">
        <i class="bi bi-cursor fs-1 mb-2 d-block"></i>
        <h5>Entity Inspector</h5>
        <p class="small mb-0">Click any node or link in the graph to inspect connected case details and evidence files.</p>
      </div>
    </div>
  </div>
</div>

<!-- Cytoscape Script Init -->
<script src="/js/cytoscape-graph.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dataUrl = '/graph/data<%= selectedCaseId && selectedCaseId !== "all" ? "?caseId=" + selectedCaseId : "" %>';
    initRelationshipGraph('cy-container', dataUrl);
  });
</script>

<%- include('../partials/footer') %>
