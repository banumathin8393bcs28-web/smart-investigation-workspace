<%- include('partials/header') %>

<div class="container py-5 my-auto">
  <div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-gov alert-dismissible fade show mb-4" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-gov alert-dismissible fade show mb-4" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="gov-card shadow-sm border">
        <div class="gov-card-header text-center justify-content-center py-3 bg-white border-bottom">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-shield-shaded text-primary fs-3"></i>
            <h1 class="h3 mb-0 fw-bold text-dark">SMART INVESTIGATION WORKSPACE</h1>
          </div>
        </div>

        <div class="gov-card-body p-4 p-md-5 text-center">
          <p class="lead text-secondary mb-4" style="font-size: 1.15rem; font-weight: 500;">
            "A secure workspace for investigation case management and digital evidence organization."
          </p>

          <p class="text-muted small mb-4" style="line-height: 1.6;">
            This system is an authorized administrative workspace designed for certified law enforcement investigators to organize crime-scene digital photographs, maintain tamper-evident chain-of-custody ledgers, execute AI-assisted object inspection, communicate securely, and generate comprehensive PDF investigation reports.
          </p>

          <hr class="my-4 border-secondary-subtle">

          <div class="d-grid d-sm-flex justify-content-sm-center gap-3">
            <a href="/auth/register" class="btn btn-gov-primary btn-lg px-4">
              <i class="bi bi-person-plus-fill me-2"></i> Register
            </a>
            <a href="/auth/login" class="btn btn-gov-secondary btn-lg px-4 border">
              <i class="bi bi-box-arrow-in-right me-2"></i> Login
            </a>
          </div>

          <div class="mt-4 pt-3 border-top border-light">
            <small class="text-muted">
              <i class="bi bi-lock-fill me-1"></i> Restricted Access: Authorized government investigators only.
            </small>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>
