<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <a href="/autopsy/jobs" class="btn btn-outline-secondary btn-sm py-0 px-2">&larr; Back to Jobs</a>
          <span class="badge badge-soft-primary"><%= job.caseNumber %></span>
          <% if (job.status === 'Completed') { %>
            <span class="badge badge-soft-success"><i class="bi bi-check-circle me-1"></i> Completed</span>
          <% } else if (job.status === 'Running') { %>
            <span class="badge badge-soft-primary"><i class="bi bi-gear me-1"></i> Running</span>
          <% } else { %>
            <span class="badge badge-soft-warning"><i class="bi bi-clock me-1"></i> <%= job.status %></span>
          <% } %>
        </div>
        <h1 class="h3 mb-0 fw-bold text-dark"><%= job.jobIdentifier %> // Autopsy Ingest Dossier</h1>
      </div>
      <div>
        <a href="/autopsy/report/<%= job._id %>" target="_blank" class="btn btn-gov-primary btn-sm">
          <i class="bi bi-file-earmark-code me-1"></i> Open Raw HTML Dossier
        </a>
      </div>
    </div>

    <!-- Summary Overview Card -->
    <div class="row g-3 mb-4">
      <div class="col-lg-8">
        <div class="gov-card shadow-sm border h-100">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-info-circle me-2 text-primary"></i> Target Environmental Metadata</span>
          </div>
          <div class="gov-card-body p-4">
            <div class="table-responsive">
              <table class="table table-gov table-sm mb-0">
                <tbody>
                  <tr>
                    <th style="width: 35%;">Data Source Target:</th>
                    <td class="fw-semibold text-dark"><%= job.dataSourceFilename %></td>
                  </tr>
                  <tr>
                    <th>Data Source Type:</th>
                    <td class="text-capitalize"><%= job.dataSourceType.replace(/_/g, ' ') %></td>
                  </tr>
                  <tr>
                    <th>Evidence Reference:</th>
                    <td>
                      <% if (evidenceDoc) { %>
                        <a href="/evidence/<%= evidenceDoc._id %>" class="fw-semibold"><%= job.evidenceIdentifier %></a>
                      <% } else { %>
                        <span class="text-muted"><%= job.evidenceIdentifier %></span>
                      <% } %>
                    </td>
                  </tr>
                  <tr>
                    <th>Associated Case:</th>
                    <td>
                      <% if (caseDoc) { %>
                        <a href="/cases/<%= caseDoc._id %>" class="fw-semibold"><%= caseDoc.caseNumber %> - <%= caseDoc.caseName %></a>
                      <% } else { %>
                        <span><%= job.caseNumber %></span>
                      <% } %>
                    </td>
                  </tr>
                  <tr>
                    <th>Ingested Modules:</th>
                    <td>
                      <% job.modulesConfigured.forEach(m => { %>
                        <span class="badge bg-light text-dark border me-1 mb-1"><%= m %></span>
                      <% }) %>
                    </td>
                  </tr>
                  <tr>
                    <th>Operating Worker:</th>
                    <td class="font-monospace small text-muted"><%= job.workerId %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="gov-card shadow-sm border h-100">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-clock-history me-2 text-primary"></i> Execution Ledger</span>
          </div>
          <div class="gov-card-body p-4">
            <div class="small mb-3">
              <span class="text-muted d-block">Submitted:</span>
              <strong class="font-monospace text-dark"><%= formatTimestamp(job.submissionTimestamp) %></strong>
              <div class="text-muted" style="font-size: 11px;">By <%= job.submitterName %></div>
            </div>

            <div class="small mb-3">
              <span class="text-muted d-block">Started:</span>
              <strong class="font-monospace text-dark"><%= job.startedTimestamp ? formatTimestamp(job.startedTimestamp) : 'Pending' %></strong>
            </div>

            <div class="small mb-3">
              <span class="text-muted d-block">Completed:</span>
              <strong class="font-monospace text-dark"><%= job.completedTimestamp ? formatTimestamp(job.completedTimestamp) : 'Running / Queued' %></strong>
            </div>

            <hr>

            <div class="d-flex justify-content-between align-items-center">
              <span class="text-muted small">Artifacts Extracted:</span>
              <span class="badge bg-primary fs-6"><%= job.findingsCount %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Extracted Artifacts & Inspection Findings -->
    <div class="gov-card shadow-sm border mb-4">
      <div class="gov-card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span><i class="bi bi-search me-2 text-primary"></i> Extracted Forensic Artifacts (<%= job.findings.length %>)</span>
        <span class="text-muted small">Authentic inspection findings generated by Autopsy platform</span>
      </div>

      <div class="gov-card-body p-0">
        <% if (job.findings && job.findings.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-gov table-hover mb-0">
              <thead>
                <tr>
                  <th style="width: 160px;">Category</th>
                  <th style="width: 220px;">Artifact Title</th>
                  <th>Observation / Findings</th>
                  <th style="width: 200px;">Source Reference</th>
                </tr>
              </thead>
              <tbody>
                <% job.findings.forEach(f => { %>
                  <tr>
                    <td>
                      <span class="badge badge-soft-primary"><%= f.category %></span>
                    </td>
                    <td>
                      <strong class="text-dark small"><%= f.title %></strong>
                    </td>
                    <td class="small text-secondary">
                      <%= f.description %>
                    </td>
                    <td class="font-monospace small text-muted text-truncate" style="max-width: 200px;" title="<%= f.sourcePath %>">
                      <%= f.sourcePath || 'N/A' %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-4 text-center text-muted">
            <i class="bi bi-search fs-2 d-block mb-2 text-secondary"></i>
            <% if (job.status === 'Running' || job.status === 'Queued') { %>
              Forensic ingest is currently processing. Refresh page shortly to view extracted artifacts.
            <% } else { %>
              Ingest completed with zero anomalous artifacts detected.
            <% } %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Live Execution Logs Console -->
    <div class="gov-card shadow-sm border">
      <div class="gov-card-header bg-white py-3 border-bottom">
        <span><i class="bi bi-terminal me-2 text-primary"></i> Ingest Execution Logs</span>
      </div>
      <div class="gov-card-body p-3 bg-dark text-light rounded-bottom" style="font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; max-height: 250px; overflow-y: auto;">
        <pre class="mb-0 text-white" style="white-space: pre-wrap;"><%= job.logOutput || 'No execution logs recorded.' %></pre>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
