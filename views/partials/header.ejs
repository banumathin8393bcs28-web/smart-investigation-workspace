<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Smart Investigation Workspace' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Custom Government Internal Administrative Style -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body data-auth-session="<%= typeof currentInvestigator !== 'undefined' && currentInvestigator ? 'true' : 'false' %>" data-user-id="<%= typeof currentInvestigator !== 'undefined' && currentInvestigator ? currentInvestigator._id : '' %>">

<% if (typeof currentInvestigator !== 'undefined' && currentInvestigator) { %>
<!-- Top Administrative Header -->
<header class="gov-topbar d-flex justify-content-between align-items-center">
  <div class="d-flex align-items-center gap-3">
    <a href="/dashboard" class="gov-topbar-brand">
      <i class="bi bi-shield-lock-fill"></i>
      <div>
        <div>SMART INVESTIGATION WORKSPACE</div>
        <div class="gov-topbar-subtitle">Digital Evidence Management & Forensic Investigation</div>
      </div>
    </a>
  </div>

  <div class="d-flex align-items-center gap-3">
    <!-- Running Live Clock -->
    <div class="gov-clock-pill text-white d-none d-md-flex align-items-center gap-2">
      <i class="bi bi-clock"></i>
      <span id="liveClock">Loading time...</span>
    </div>

    <!-- Notification Indicator -->
    <a href="/notifications" class="text-white text-decoration-none position-relative px-2" title="Notification Center">
      <i class="bi bi-bell-fill fs-5"></i>
      <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
        <span id="topbarNotificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
          <%= unreadNotificationsCount %>
        </span>
      <% } else { %>
        <span id="topbarNotificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
      <% } %>
    </a>

    <!-- Investigator Profile Pill -->
    <div class="gov-user-pill text-white border-start ps-3 border-secondary">
      <img src="<%= currentInvestigator.profilePhoto || '/images/default-avatar.png' %>" alt="Profile" class="gov-avatar-sm">
      <div class="d-none d-sm-block text-start">
        <div class="fw-bold lh-1"><%= currentInvestigator.fullName %></div>
        <small class="text-white-50" style="font-size: 11px;"><%= currentInvestigator.role %></small>
      </div>
    </div>

    <!-- Visible Sign Out Button -->
    <a href="/auth/logout" class="btn btn-outline-light btn-sm ms-2" title="Sign Out">
      <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Sign Out</span>
    </a>
  </div>
</header>
<% } %>

<!-- Live Notification Toast Container -->
<div id="liveNotificationToastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 9999; max-width: 350px;"></div>
