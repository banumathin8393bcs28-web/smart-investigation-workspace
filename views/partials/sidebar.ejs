<!-- Mobile Sidebar Backdrop -->
<div class="gov-sidebar-backdrop" id="sidebarBackdrop"></div>

<nav class="gov-sidebar">
  <!-- Officer Mini Identification Card -->
  <div class="gov-sidebar-user-card">
    <img src="<%= currentInvestigator.profilePhoto || '/images/default-avatar.png' %>" alt="Officer Avatar" class="gov-avatar-sm" style="width: 36px; height: 36px;">
    <div class="overflow-hidden">
      <div class="fw-bold small text-dark text-truncate" title="<%= currentInvestigator.fullName %>"><%= currentInvestigator.fullName %></div>
      <div class="text-muted text-truncate" style="font-size: 11px;"><%= currentInvestigator.email %></div>
      <div class="badge bg-secondary-subtle text-secondary-emphasis border mt-1" style="font-size: 10px; font-weight: 500;">
        <%= currentInvestigator.role %>
      </div>
    </div>
  </div>

  <div class="overflow-y-auto flex-grow-1">
    <!-- Section: Operations -->
    <div class="gov-sidebar-section-title">Core Operations</div>
    <ul class="gov-sidebar-menu mb-2">
      <li class="gov-sidebar-item">
        <a href="/dashboard" class="gov-sidebar-link <%= (typeof title !== 'undefined' && title.includes('Dashboard')) ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i>
          <span>Dashboard</span>
        </a>
      </li>
      <li class="gov-sidebar-item">
        <a href="/cases/new" class="gov-sidebar-link <%= (typeof title !== 'undefined' && title.includes('Create New Case')) ? 'active' : '' %>">
          <i class="bi bi-folder-plus"></i>
          <span>Create New Case</span>
        </a>
      </li>
      <li class="gov-sidebar-item">
        <a href="/cases" class="gov-sidebar-link <%= (typeof title !== 'undefined' && title.includes('Existing Investigation Cases') || title.includes('Case #')) ? 'active' : '' %>">
          <i class="bi bi-folder2-open"></i>
          <span>View Existing Cases</span>
        </a>
      </li>
    </ul>

    <!-- Section: Forensics -->
    <div class="gov-sidebar-section-title">Forensic Modules</div>
    <ul class="gov-sidebar-menu mb-2">
      <li class="gov-sidebar-item">
        <a href="/custody" class="gov-sidebar-link <%= (typeof title !== 'undefined' && title.includes('Custody')) ? 'active' : '' %>">
          <i class="bi bi-shield-check"></i>
          <span>Chain of Custody</span>
        </a>
      </li>
      <li class="gov-sidebar-item">
        <a href="/reports" class="gov-sidebar-link <%= (typeof title !== 'undefined' && title.includes('Report')) ? 'active' : '' %>">
          <i class="bi bi-file-earmark-pdf"></i>
          <span>Generate Report</span>
        </a>
      </li>
    </ul>

    <!-- Section: Collaboration -->
    <div class="gov-sidebar-section-title">Communication & Alerts</div>
    <ul class="gov-sidebar-menu mb-2">
      <li class="gov-sidebar-item">
        <a href="/contacts" class="gov-sidebar-link <%= (typeof title !== 'undefined' && title.includes('Contacts')) ? 'active' : '' %>">
          <i class="bi bi-people"></i>
          <span>Investigator Communication</span>
        </a>
      </li>
      <li class="gov-sidebar-item">
        <a href="/notifications" class="gov-sidebar-link <%= (typeof title !== 'undefined' && title.includes('Notification')) ? 'active' : '' %>">
          <i class="bi bi-bell"></i>
          <span>Notifications</span>
          <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
            <span class="gov-sidebar-badge"><%= unreadNotificationsCount %></span>
          <% } %>
        </a>
      </li>
    </ul>

    <!-- Section: Settings -->
    <div class="gov-sidebar-section-title">Account</div>
    <ul class="gov-sidebar-menu">
      <li class="gov-sidebar-item">
        <a href="/profile/edit" class="gov-sidebar-link <%= (typeof title !== 'undefined' && title.includes('Profile')) ? 'active' : '' %>">
          <i class="bi bi-person-gear"></i>
          <span>Edit Profile</span>
        </a>
      </li>
      <li class="gov-sidebar-item mt-2 pt-2 border-top border-secondary-subtle">
        <a href="/auth/logout" class="gov-sidebar-link text-danger">
          <i class="bi bi-box-arrow-right text-danger"></i>
          <span>Sign Out</span>
        </a>
      </li>
    </ul>
  </div>
</nav>
