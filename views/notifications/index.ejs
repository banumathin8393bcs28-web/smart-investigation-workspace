<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Notification Center</h1>
        <small class="text-muted">Real-time alerts, transfer requests, new messages, and case updates</small>
      </div>
      <% if (notifications && notifications.some(n => !n.isRead)) { %>
        <form action="/notifications/mark-all-read" method="POST">
          <button type="submit" class="btn btn-gov-secondary btn-sm">
            <i class="bi bi-check2-all me-1"></i> Mark All as Read
          </button>
        </form>
      <% } %>
    </div>

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="gov-card shadow-sm border">
      <div class="gov-card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-bell-fill me-2"></i> System & Investigative Alerts (<%= notifications.length %>)</span>
      </div>
      <div class="gov-card-body p-0">
        <% if (notifications && notifications.length > 0) { %>
          <div class="list-group list-group-flush">
            <% notifications.forEach(n => { %>
              <div class="list-group-item p-3 d-flex justify-content-between align-items-start <%= !n.isRead ? 'bg-light border-start border-3 border-primary' : '' %>">
                <div class="d-flex gap-3 align-items-start">
                  <div class="fs-4 text-<%= n.notificationType.includes('transfer') ? 'warning' : (n.notificationType.includes('message') ? 'primary' : 'secondary') %>">
                    <i class="bi <%= n.notificationType.includes('message') ? 'bi-chat-dots-fill' : (n.notificationType.includes('transfer') ? 'bi-arrow-left-right' : 'bi-info-circle-fill') %>"></i>
                  </div>
                  <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                      <strong class="text-dark"><%= n.title %></strong>
                      <% if (n.caseNumber) { %>
                        <span class="badge bg-light text-primary border"><%= n.caseNumber %></span>
                      <% } %>
                      <% if (!n.isRead) { %>
                        <span class="badge bg-danger">New</span>
                      <% } %>
                    </div>
                    <div class="text-secondary small mb-2"><%= n.notificationText %></div>
                    <div class="d-flex gap-3 text-muted" style="font-size: 11px;">
                      <span>Officer: <%= n.senderName %></span>
                      <span>Received: <%= formatTimestamp(n.createdTimestamp) %></span>
                    </div>
                  </div>
                </div>

                <div class="text-end">
                  <% if (n.actionLink) { %>
                    <a href="/notifications/<%= n._id %>/read" class="btn btn-gov-primary btn-sm py-1 px-3">
                      Review & Action &rarr;
                    </a>
                  <% } else if (!n.isRead) { %>
                    <a href="/notifications/<%= n._id %>/read" class="btn btn-gov-secondary btn-sm py-1 px-2">
                      Mark Read
                    </a>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="p-5 text-center text-muted">
            <i class="bi bi-bell-slash fs-2 mb-2 d-block"></i>
            No notifications in your inbox.
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
