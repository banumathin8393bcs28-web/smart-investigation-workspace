<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Chain of Custody & Evidence Ledger</h1>
        <small class="text-muted">Tamper-evident chronological audit trail of case assignments and physical evidence custody</small>
      </div>
      <div class="d-flex gap-2">
        <a href="/custody/transfer-case" class="btn btn-gov-primary btn-sm">
          <i class="bi bi-arrow-left-right me-1"></i> Initiate Case Transfer
        </a>
      </div>
    </div>

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Pending Custody & Assignment Transfers Awaiting Action -->
    <% if (pendingTransfers && pendingTransfers.length > 0) { %>
      <div class="gov-card border-warning mb-4 shadow-sm">
        <div class="gov-card-header bg-warning-subtle text-dark d-flex justify-content-between align-items-center py-3">
          <span class="fw-bold"><i class="bi bi-exclamation-circle-fill text-warning me-2"></i> Incoming Transfers Awaiting Your Decision (<%= pendingTransfers.length %>)</span>
          <span class="badge bg-warning text-dark">Action Required</span>
        </div>
        <div class="gov-card-body p-0">
          <div class="table-responsive">
            <table class="table table-gov mb-0">
              <thead>
                <tr>
                  <th>Event ID</th>
                  <th>Case #</th>
                  <th>Transferor Officer</th>
                  <th>Transfer Reason</th>
                  <th>Requested (IST)</th>
                  <th style="min-width: 250px;">Your Decision</th>
                </tr>
              </thead>
              <tbody>
                <% pendingTransfers.forEach(t => { %>
                  <tr>
                    <td class="fw-bold font-monospace"><%= t.eventId %></td>
                    <td>
                      <a href="/cases/<%= t.caseId._id %>" class="fw-bold font-monospace text-primary text-decoration-none">
                        <%= t.caseNumber %>
                      </a>
                    </td>
                    <td class="fw-semibold"><%= t.transferorName %></td>
                    <td class="small"><%= t.reason %></td>
                    <td class="small text-muted font-monospace"><%= formatTimestamp(t.eventTimestamp) %></td>
                    <td>
                      <form action="/custody/respond/<%= t._id %>" method="POST" class="d-flex flex-column gap-2 py-1">
                        <input type="text" name="responseNotes" class="form-control form-control-sm" placeholder="Review remarks / acceptance notes..." required>
                        <div class="d-flex gap-2">
                          <button type="submit" name="response" value="Accept" class="btn btn-success btn-sm flex-grow-1">
                            <i class="bi bi-check2"></i> Accept Case
                          </button>
                          <button type="submit" name="response" value="Reject" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-x"></i> Reject
                          </button>
                        </div>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Chronological Custody History -->
    <div class="gov-card shadow-sm">
      <div class="gov-card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-2 text-primary"></i> Master Chronological Custody Ledger (<%= custodyHistory.length %> Events)</span>
        <% if (filterCaseId) { %>
          <a href="/custody" class="btn btn-gov-secondary btn-sm py-0 px-2 small">Clear Case Filter</a>
        <% } %>
      </div>
      <div class="gov-card-body p-0">
        <% if (custodyHistory && custodyHistory.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-gov mb-0">
              <thead>
                <tr>
                  <th>Event ID</th>
                  <th>Case #</th>
                  <th>Custody Action</th>
                  <th>Actor Officer</th>
                  <th>Transfer Directive</th>
                  <th>Justification / Reason</th>
                  <th>Timestamp (IST)</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% custodyHistory.forEach(c => { %>
                  <tr>
                    <td class="fw-bold font-monospace"><%= c.eventId %></td>
                    <td>
                      <a href="/cases/<%= c.caseId %>" class="fw-bold font-monospace text-primary text-decoration-none">
                        <%= c.caseNumber %>
                      </a>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= c.action %></span></td>
                    <td class="fw-semibold"><%= c.actorName %></td>
                    <td class="small">
                      <% if (c.transferorName && c.recipientName) { %>
                        <%= c.transferorName %> &rarr; <%= c.recipientName %>
                      <% } else { %>
                        <span class="text-muted">Internal Case Action</span>
                      <% } %>
                    </td>
                    <td class="small"><%= c.reason %></td>
                    <td class="small text-muted font-monospace"><%= formatTimestamp(c.eventTimestamp) %></td>
                    <td>
                      <span class="badge <%= c.status === 'Completed' ? 'badge-soft-success' : (c.status === 'Pending' ? 'badge-soft-warning' : 'badge-soft-danger') %>">
                        <%= c.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-5 text-center text-muted">
            <i class="bi bi-shield-x fs-2 mb-2 d-block text-secondary"></i>
            No custody events recorded matching current view.
          </div>
        <% } %>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
