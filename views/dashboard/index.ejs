<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <!-- Practical Administrative Sidebar -->
  <%- include('../partials/sidebar') %>

  <!-- Main Workspace Area -->
  <main class="gov-main-content">

    <!-- Flash notifications -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Workspace Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Investigator Operational Dashboard</h1>
        <div class="text-muted small d-flex flex-wrap align-items-center gap-2">
          <span>Active Officer: <strong class="text-dark"><%= currentInvestigator.fullName %></strong></span>
          <span>&bull;</span>
          <span class="badge bg-secondary-subtle text-secondary-emphasis border"><%= currentInvestigator.role %></span>
          <span class="d-none d-sm-inline">&bull;</span>
          <span class="d-none d-sm-inline">Digital Forensics & Central Investigation Division</span>
        </div>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a href="/cases/new" class="btn btn-gov-primary btn-sm">
          <i class="bi bi-folder-plus me-1"></i> Ingest New Case
        </a>
        <a href="/custody/transfer-case" class="btn btn-gov-secondary btn-sm">
          <i class="bi bi-arrow-left-right me-1"></i> Transfer Case
        </a>
      </div>
    </div>

    <!-- Summary Metrics (MongoDB Aggregates) -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <a href="/cases" class="text-decoration-none">
          <div class="gov-stat-tile h-100">
            <div class="gov-stat-header">
              <span class="gov-stat-label">Assigned Cases</span>
              <div class="gov-stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-folder2-open"></i>
              </div>
            </div>
            <div class="gov-stat-value"><%= stats.totalAssignedCases %></div>
          </div>
        </a>
      </div>

      <div class="col-6 col-md-3">
        <a href="/cases" class="text-decoration-none">
          <div class="gov-stat-tile h-100">
            <div class="gov-stat-header">
              <span class="gov-stat-label">Active Cases</span>
              <div class="gov-stat-icon bg-info-subtle text-info">
                <i class="bi bi-activity"></i>
              </div>
            </div>
            <div class="gov-stat-value text-primary"><%= stats.activeCases %></div>
          </div>
        </a>
      </div>

      <div class="col-6 col-md-3">
        <div class="gov-stat-tile h-100">
          <div class="gov-stat-header">
            <span class="gov-stat-label">Evidence Items</span>
            <div class="gov-stat-icon bg-success-subtle text-success">
              <i class="bi bi-images"></i>
            </div>
          </div>
          <div class="gov-stat-value"><%= stats.evidenceItemsCount %></div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <a href="/autopsy/jobs" class="text-decoration-none">
          <div class="gov-stat-tile h-100">
            <div class="gov-stat-header">
              <span class="gov-stat-label">Autopsy Ingest Jobs</span>
              <div class="gov-stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-hdd-network"></i>
              </div>
            </div>
            <div class="gov-stat-value"><%= typeof stats.autopsyJobsCount !== 'undefined' ? stats.autopsyJobsCount : 0 %></div>
          </div>
        </a>
      </div>

      <div class="col-6 col-md-3">
        <a href="/evidence/requests" class="text-decoration-none">
          <div class="gov-stat-tile h-100">
            <div class="gov-stat-header">
              <span class="gov-stat-label">Evidence Requests</span>
              <div class="gov-stat-icon bg-warning-subtle text-warning">
                <i class="bi bi-arrow-left-right"></i>
              </div>
            </div>
            <div class="gov-stat-value <%= stats.pendingRequestsCount > 0 ? 'text-danger' : 'text-dark' %>">
              <%= typeof stats.pendingRequestsCount !== 'undefined' ? stats.pendingRequestsCount : 0 %>
            </div>
          </div>
        </a>
      </div>

      <div class="col-6 col-md-3">
        <a href="/custody" class="text-decoration-none">
          <div class="gov-stat-tile h-100">
            <div class="gov-stat-header">
              <span class="gov-stat-label">Custody Transfers</span>
              <div class="gov-stat-icon bg-secondary-subtle text-secondary">
                <i class="bi bi-shield-check"></i>
              </div>
            </div>
            <div class="gov-stat-value <%= stats.pendingTransfers > 0 ? 'text-danger' : 'text-dark' %>">
              <%= stats.pendingTransfers %>
            </div>
          </div>
        </a>
      </div>

      <div class="col-6 col-md-3">
        <a href="/messages" class="text-decoration-none">
          <div class="gov-stat-tile h-100">
            <div class="gov-stat-header">
              <span class="gov-stat-label">Unread Messages</span>
              <div class="gov-stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-chat-dots"></i>
              </div>
            </div>
            <div class="gov-stat-value <%= stats.unreadMessages > 0 ? 'text-primary' : 'text-dark' %>">
              <%= stats.unreadMessages %>
            </div>
          </div>
        </a>
      </div>

      <div class="col-6 col-md-3">
        <div class="gov-stat-tile h-100">
          <div class="gov-stat-header">
            <span class="gov-stat-label">Closed Cases</span>
            <div class="gov-stat-icon bg-secondary-subtle text-secondary">
              <i class="bi bi-check2-circle"></i>
            </div>
          </div>
          <div class="gov-stat-value text-muted"><%= stats.closedCases %></div>
        </div>
      </div>
    </div>

    <!-- Main Content Columns -->
    <div class="row g-4">

      <!-- Left Column: Active Cases & Activity -->
      <div class="col-lg-7">
        <div class="gov-card mb-4">
          <div class="gov-card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-folder2-open me-2 text-primary"></i> Authorized Cases (Recent Activity)</span>
            <a href="/cases" class="btn btn-gov-secondary btn-sm py-0 px-2 small">View All Cases</a>
          </div>
          <div class="gov-card-body p-0">
            <% if (recentCases && recentCases.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-gov mb-0">
                  <thead>
                    <tr>
                      <th>Case #</th>
                      <th>Case Title</th>
                      <th>Classification</th>
                      <th>Status</th>
                      <th>Last Modified</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% recentCases.forEach(c => { %>
                      <tr>
                        <td>
                          <a href="/cases/<%= c._id %>" class="fw-bold text-decoration-none text-primary">
                            <%= c.caseNumber %>
                          </a>
                        </td>
                        <td>
                          <a href="/cases/<%= c._id %>" class="text-dark text-decoration-none fw-medium">
                            <%= c.caseName %>
                          </a>
                        </td>
                        <td><span class="badge bg-light text-dark border"><%= c.crimeType %></span></td>
                        <td>
                          <span class="badge <%= c.status === 'Closed' ? 'badge-soft-secondary' : (c.status === 'Under Investigation' ? 'badge-soft-primary' : 'badge-soft-warning') %>">
                            <%= c.status %>
                          </span>
                        </td>
                        <td class="small text-muted">
                          <%= formatTimestamp(c.lastUpdatedTimestamp, { includeSeconds: false }) %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="p-4 text-center text-muted">
                <i class="bi bi-inbox fs-2 mb-2 d-block text-secondary"></i>
                No cases registered yet. Click <strong>Ingest New Case</strong> to initialize your first investigation file.
              </div>
            <% } %>
          </div>
        </div>

        <!-- Recent Audit Activity Log -->
        <div class="gov-card mb-0">
          <div class="gov-card-header">
            <span><i class="bi bi-journal-text me-2 text-primary"></i> Recent Security & Investigative Activity Log</span>
          </div>
          <div class="gov-card-body p-0">
            <% if (recentActivities && recentActivities.length > 0) { %>
              <ul class="list-group list-group-flush small">
                <% recentActivities.forEach(act => { %>
                  <li class="list-group-item d-flex justify-content-between align-items-start py-2 px-3">
                    <div>
                      <div class="fw-medium text-dark">
                        <span class="badge bg-light text-secondary border me-1"><%= act.action %></span>
                        <%= act.changeSummary %>
                      </div>
                      <small class="text-muted">
                        Officer: <%= act.actorName %> &bull; IP: <%= act.ipAddress %>
                      </small>
                    </div>
                    <span class="text-muted small ps-2 text-nowrap">
                      <%= formatTimestamp(act.timestamp, { includeSeconds: false }) %>
                    </span>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="p-3 text-muted text-center small">No recorded activity logs found.</div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Right Column: Notifications & Quick Access -->
      <div class="col-lg-5">

        <!-- Notification Highlights -->
        <div class="gov-card mb-4">
          <div class="gov-card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-bell me-2 text-primary"></i> Notification Center</span>
            <a href="/notifications" class="btn btn-gov-secondary btn-sm py-0 px-2 small">Full Center</a>
          </div>
          <div class="gov-card-body p-0">
            <% if (recentNotifications && recentNotifications.length > 0) { %>
              <ul class="list-group list-group-flush small">
                <% recentNotifications.forEach(n => { %>
                  <li class="list-group-item py-2 px-3 <%= !n.isRead ? 'bg-light border-start border-3 border-primary' : '' %>">
                    <div class="d-flex justify-content-between">
                      <strong class="text-dark"><%= n.title %></strong>
                      <span class="text-muted" style="font-size: 11px;"><%= formatTimestamp(n.createdTimestamp, { includeSeconds: false }) %></span>
                    </div>
                    <div class="text-secondary mb-1"><%= n.notificationText %></div>
                    <% if (n.actionLink) { %>
                      <a href="/notifications/<%= n._id %>/read" class="small text-decoration-none fw-semibold">Review & Action &rarr;</a>
                    <% } %>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="p-3 text-muted text-center small">No recent notifications.</div>
            <% } %>
          </div>
        </div>

        <!-- Quick Modules Panel -->
        <div class="gov-card mb-0">
          <div class="gov-card-header">
            <span><i class="bi bi-grid me-2 text-primary"></i> Quick Operational Directives</span>
          </div>
          <div class="gov-card-body p-3">
            <div class="d-grid gap-2">
              <a href="/cases/new" class="btn btn-gov-secondary text-start d-flex justify-content-between align-items-center p-2 px-3">
                <span><i class="bi bi-plus-circle text-primary me-2"></i> Ingest New Investigation Case</span>
                <i class="bi bi-chevron-right text-muted small"></i>
              </a>
              <a href="/contacts" class="btn btn-gov-secondary text-start d-flex justify-content-between align-items-center p-2 px-3">
                <span><i class="bi bi-chat-left-dots text-primary me-2"></i> Investigator Communication</span>
                <i class="bi bi-chevron-right text-muted small"></i>
              </a>
              <a href="/custody" class="btn btn-gov-secondary text-start d-flex justify-content-between align-items-center p-2 px-3">
                <span><i class="bi bi-shield-check text-primary me-2"></i> Chain of Custody Ledger</span>
                <i class="bi bi-chevron-right text-muted small"></i>
              </a>
              <a href="/reports" class="btn btn-gov-secondary text-start d-flex justify-content-between align-items-center p-2 px-3">
                <span><i class="bi bi-file-earmark-pdf text-danger me-2"></i> Generate Forensic PDF Report</span>
                <i class="bi bi-chevron-right text-muted small"></i>
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>

  </main>
</div>

<%- include('../partials/footer') %>
