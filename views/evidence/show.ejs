<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
          <span class="badge bg-dark font-monospace fs-6 px-2 py-1"><%= evidence.evidenceIdentifier %></span>
          <h1 class="h4 mb-0 fw-bold text-dark"><%= evidence.originalFilename %></h1>
          <span class="badge <%= evidence.inspectionStatus === 'Inspected' ? 'badge-soft-success' : 'badge-soft-secondary' %>">
            <%= evidence.inspectionStatus %>
          </span>
        </div>
        <small class="text-muted d-flex flex-wrap align-items-center gap-2">
          <span>Case: <a href="/cases/<%= caseDoc._id %>" class="text-primary fw-semibold"><%= caseDoc.caseNumber %>: <%= caseDoc.caseName %></a></span>
          <span>&bull;</span>
          <span class="font-monospace">Uploaded: <%= formatTimestamp(evidence.uploadTimestamp) %> by <%= evidence.uploaderName %></span>
        </small>
      </div>
      <div class="d-flex gap-2">
        <a href="/cases/<%= caseDoc._id %>" class="btn btn-gov-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Return to Case
        </a>
        <a href="/evidence/<%= evidence._id %>/file" class="btn btn-gov-primary btn-sm" download>
          <i class="bi bi-download me-1"></i> Download Original Bytes
        </a>
      </div>
    </div>

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="row g-4">

      <!-- Left Column: Image Previews & AI Inspection -->
      <div class="col-lg-6">

        <!-- Image Card -->
        <div class="gov-card shadow-sm mb-4">
          <div class="gov-card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span><i class="bi bi-image text-primary me-2"></i> Evidence Photography Artifact</span>
            <span class="text-muted small font-monospace">MIME: <%= evidence.fileMimeType %></span>
          </div>
          <div class="gov-card-body text-center p-3 bg-light rounded-bottom">
            <%
              const latestSuccessInspection = inspections.find(i => i.inspectionStatus === 'Success');
            %>
            <div class="ai-preview-box w-100 text-center" style="min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
              <% if (latestSuccessInspection && latestSuccessInspection.annotatedImageReference) { %>
                <img src="/evidence/<%= evidence._id %>/annotated" alt="Annotated Evidence" class="img-fluid rounded border shadow-sm mx-auto" style="max-height: 440px; object-fit: contain;">
                <div class="small text-danger fw-semibold mt-2">
                  <i class="bi bi-bounding-box me-1"></i> Displaying YOLOv8 AI Detection Overlay (Original raw bytes preserved intact)
                </div>
              <% } else { %>
                <img src="/evidence/<%= evidence._id %>/file" alt="Evidence" class="img-fluid rounded border shadow-sm mx-auto" style="max-height: 440px; object-fit: contain;">
                <div class="small text-success fw-semibold mt-2">
                  <i class="bi bi-check-circle text-success me-1"></i> Original Raw Evidence Photograph
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- AI Object Detection Control -->
        <div class="gov-card shadow-sm mb-4 border-primary">
          <div class="gov-card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="text-primary fw-bold"><i class="bi bi-cpu-fill me-2"></i> AI Computer Vision Object Detection</span>
            <span class="badge bg-primary-subtle text-primary border">Ultralytics YOLOv8</span>
          </div>
          <div class="gov-card-body p-4">
            <p class="small text-muted mb-3" style="line-height: 1.5;">
              The AI inspection engine correlates case context (e.g. <em><%= caseDoc.knownObjects || caseDoc.caseDescription.substring(0, 80) %>...</em>) with official YOLOv8 neural network inference to detect weapons, vehicles, bags, tools, bottles, and persons.
            </p>

            <form action="/evidence/<%= evidence._id %>/inspect" method="POST" class="row g-2 align-items-end mb-3">
              <div class="col-sm-6">
                <label class="form-label small" for="confidenceThreshold">Confidence Threshold</label>
                <select class="form-select form-select-sm" id="confidenceThreshold" name="confidenceThreshold">
                  <option value="0.15">15% (Permissive Forensic Scan)</option>
                  <option value="0.25" selected>25% (Standard Baseline)</option>
                  <option value="0.40">40% (High Confidence)</option>
                  <option value="0.60">60% (Strict Positive)</option>
                </select>
              </div>
              <div class="col-sm-6">
                <button type="submit" class="btn btn-gov-primary btn-sm w-100 py-2" id="inspectBtn">
                  <i class="bi bi-search me-1"></i> Run AI Inspection
                </button>
              </div>
            </form>

            <div class="alert alert-light border py-2 px-3 mb-0" style="font-size: 11px; line-height: 1.4;">
              <strong>Model Limitation Note:</strong> YOLOv8 detections assist investigator triage and do not constitute conclusive judicial proof. Non-detection does not prove absence.
            </div>
          </div>
        </div>

        <!-- AI Inspection History -->
        <div class="gov-card shadow-sm mb-0">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-clock-history text-primary me-2"></i> AI Inspection Execution History</span>
          </div>
          <div class="gov-card-body p-0">
            <% if (inspections.length > 0) { %>
              <ul class="list-group list-group-flush small">
                <% inspections.forEach(insp => { %>
                  <li class="list-group-item p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="badge <%= insp.inspectionStatus === 'Success' ? 'badge-soft-success' : (insp.inspectionStatus === 'No Objects Detected' ? 'badge-soft-secondary' : 'badge-soft-danger') %>">
                        <%= insp.inspectionStatus %>
                      </span>
                      <span class="text-muted font-monospace" style="font-size: 11px;">
                        <%= formatTimestamp(insp.inspectionTimestamp) %>
                      </span>
                    </div>

                    <div class="fw-medium text-dark mb-1"><%= insp.summaryMessage %></div>

                    <% if (insp.detections && insp.detections.length > 0) { %>
                      <div class="mt-2 pt-2 border-top">
                        <strong class="d-block mb-1 text-uppercase text-muted" style="font-size: 10px;">Detected Entities:</strong>
                        <div class="d-flex flex-wrap gap-1">
                          <% insp.detections.forEach(det => { %>
                            <span class="badge <%= det.isContextMatch ? 'bg-danger text-white' : 'bg-light text-dark border' %>">
                              <%= det.label %>: <%= Math.round(det.confidence * 100) %>%
                              <% if (det.isContextMatch) { %><i class="bi bi-asterisk ms-1" title="Context Match"></i><% } %>
                            </span>
                          <% }) %>
                        </div>
                      </div>
                    <% } %>

                    <div class="text-muted mt-2" style="font-size: 11px;">
                      Inspected by: <%= insp.inspectedByName %> &bull; Model: <%= insp.modelName %> (<%= insp.modelVersion %>)
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="p-4 text-center text-muted small">No AI inspections recorded for this evidence item yet.</div>
            <% } %>
          </div>
        </div>

      </div>

      <!-- Right Column: Metadata, EXIF & Cryptography -->
      <div class="col-lg-6">

        <!-- SHA-256 Digest & Storage Card -->
        <div class="gov-card shadow-sm mb-4">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-shield-check text-success me-2"></i> Cryptographic Integrity & File Metadata</span>
          </div>
          <div class="gov-card-body p-4">
            <div class="mb-3">
              <label class="form-label small text-muted mb-1 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">Cryptographic SHA-256 Digest:</label>
              <div class="d-flex align-items-center gap-2">
                <input type="text" class="form-control form-control-sm font-monospace text-dark bg-light fw-bold" value="<%= evidence.sha256Hash %>" readonly>
                <button class="btn btn-gov-secondary btn-sm btn-copy-hash" data-hash="<%= evidence.sha256Hash %>" title="Copy SHA-256 Digest">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
              <small class="text-muted" style="font-size: 11px;">
                Calculated directly on raw original bytes upon upload. Tamper-evident.
              </small>
            </div>

            <div class="table-responsive">
              <table class="table table-gov table-sm mb-0">
                <tbody>
                  <tr>
                    <th style="width: 40%;">Original Filename:</th>
                    <td class="fw-semibold"><%= evidence.originalFilename %></td>
                  </tr>
                  <tr>
                    <th>File Size:</th>
                    <td><%= (evidence.fileSize / 1024).toFixed(1) %> KB (<%= evidence.fileSize %> bytes)</td>
                  </tr>
                  <tr>
                    <th>MIME Classification:</th>
                    <td class="font-monospace small"><%= evidence.fileMimeType %></td>
                  </tr>
                  <tr>
                    <th>Image Resolution:</th>
                    <td><%= evidence.imageProperties.width %> &times; <%= evidence.imageProperties.height %> pixels</td>
                  </tr>
                  <tr>
                    <th>Color Space:</th>
                    <td><%= evidence.imageProperties.colorSpace || 'sRGB' %></td>
                  </tr>
                  <tr>
                    <th>Current Custodian:</th>
                    <td class="fw-semibold"><%= evidence.currentCustodianName %></td>
                  </tr>
                  <tr>
                    <th>Protected Storage Path:</th>
                    <td class="small font-monospace text-truncate text-muted" style="max-width: 250px;" title="<%= evidence.protectedStoragePath %>">
                      <%= evidence.protectedStoragePath %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- EXIF Camera & Forensic Metadata -->
        <div class="gov-card shadow-sm mb-4">
          <div class="gov-card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span><i class="bi bi-camera text-primary me-2"></i> EXIF Forensic Camera Metadata</span>
            <% const exif = evidence.availableMetadata || evidence.exifMetadata || { hasExif: false }; %>
            <span class="badge <%= exif.hasExif ? 'badge-soft-success' : 'badge-soft-secondary' %>">
              <%= exif.hasExif ? 'EXIF Available' : 'No EXIF Found' %>
            </span>
          </div>
          <div class="gov-card-body p-4">
            <% if (exif.hasExif) { %>
              <div class="table-responsive">
                <table class="table table-gov table-sm mb-0">
                  <tbody>
                    <tr>
                      <th style="width: 40%;">Camera Make:</th>
                      <td><%= exif.make || exif.cameraMake || 'Not specified' %></td>
                    </tr>
                    <tr>
                      <th>Camera Model:</th>
                      <td><%= exif.model || exif.cameraModel || 'Not specified' %></td>
                    </tr>
                    <tr>
                      <th>Original Date/Time:</th>
                      <td class="font-monospace"><%= exif.dateTimeOriginal ? (typeof formatTimestamp === 'function' ? formatTimestamp(exif.dateTimeOriginal) : exif.dateTimeOriginal) : 'Not recorded' %></td>
                    </tr>
                    <tr>
                      <th>Orientation:</th>
                      <td><%= exif.orientation || 'Normal (1)' %></td>
                    </tr>
                    <% if (exif.exposureTime || exif.fNumber || exif.iso) { %>
                    <tr>
                      <th>Exposure / Aperture / ISO:</th>
                      <td>
                        <%= exif.exposureTime ? `${exif.exposureTime} s ` : '' %>
                        <%= exif.fNumber ? `f/${exif.fNumber} ` : '' %>
                        <%= exif.iso ? `ISO ${exif.iso}` : '' %>
                      </td>
                    </tr>
                    <% } %>
                    <tr>
                      <th>GPS Coordinates:</th>
                      <td>
                        <% const lat = (exif.latitude !== undefined && exif.latitude !== null) ? exif.latitude : exif.gpsLatitude; %>
                        <% const lng = (exif.longitude !== undefined && exif.longitude !== null) ? exif.longitude : exif.gpsLongitude; %>
                        <% if (lat && lng) { %>
                          <span class="font-monospace"><%= (typeof lat === 'number' ? lat.toFixed(6) : lat) %>, <%= (typeof lng === 'number' ? lng.toFixed(6) : lng) %></span>
                          <a href="https://maps.google.com/?q=<%= lat %>,<%= lng %>" target="_blank" class="ms-1 small">
                            <i class="bi bi-box-arrow-up-right"></i>
                          </a>
                        <% } else { %>
                          <span class="text-muted">Not recorded in EXIF header</span>
                        <% } %>
                      </td>
                    </tr>
                    <% if (exif.rawExifSummary && exif.rawExifSummary !== 'No EXIF metadata available.') { %>
                    <tr>
                      <th>Forensic Summary:</th>
                      <td class="small text-muted"><%= exif.rawExifSummary %></td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="p-3 text-center text-muted small">
                <i class="bi bi-info-circle me-1"></i> No EXIF header metadata was found in this image file (common in screenshots or sanitized captures). Sharp image properties above remain authoritatively recorded.
              </div>
            <% } %>
          </div>
        </div>

        <!-- Editable Description Note -->
        <div class="gov-card shadow-sm mb-0">
          <div class="gov-card-header bg-white py-3 border-bottom">
            <span><i class="bi bi-pencil me-2 text-primary"></i> Investigator Evidentiary Notes</span>
          </div>
          <div class="gov-card-body p-4">
            <form action="/evidence/<%= evidence._id %>/edit-description" method="POST">
              <div class="mb-3">
                <label class="form-label small" for="description">Item Description & Orientation Notes</label>
                <textarea class="form-control" id="description" name="description" rows="3" placeholder="Enter notes regarding where item was discovered, evidence marker number, or physical observations..."><%= evidence.description || '' %></textarea>
              </div>
              <button type="submit" class="btn btn-gov-secondary btn-sm">
                <i class="bi bi-check2 me-1"></i> Update Notes
              </button>
            </form>
          </div>
        </div>

      </div>

    </div>

  </main>
</div>

<%- include('../partials/footer') %>
