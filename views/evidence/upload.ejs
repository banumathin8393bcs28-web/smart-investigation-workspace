<%- include('../partials/header') %>

<div class="gov-app-wrapper">
  <%- include('../partials/sidebar') %>

  <main class="gov-main-content">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 border-bottom gap-2">
      <div>
        <h1 class="h4 mb-1 fw-bold text-dark">Add Crime-Scene Digital Photographs</h1>
        <small class="text-muted">Associated Case: <strong class="text-dark font-monospace"><%= caseDoc.caseNumber %></strong> &bull; <%= caseDoc.caseName %></small>
      </div>
      <a href="/cases/<%= caseDoc._id %>" class="btn btn-gov-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Return to Case
      </a>
    </div>

    <% if (errors.files || errors.general) { %>
      <div class="alert alert-danger alert-gov alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= errors.files || errors.general %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="gov-card shadow-sm border">
      <div class="gov-card-header bg-white py-3 border-bottom">
        <div class="d-flex align-items-center gap-3">
          <div class="gov-brand-icon" style="width: 36px; height: 36px; font-size: 1.1rem;">
            <i class="bi bi-cloud-arrow-up-fill"></i>
          </div>
          <div>
            <h5 class="mb-0 fw-bold">Evidence File Upload Interface</h5>
            <small class="text-muted">Upload original crime-scene photography for cryptographic hashing, EXIF parsing, and AI inspection</small>
          </div>
        </div>
      </div>

      <div class="gov-card-body p-4">
        <form action="/evidence/upload" method="POST" enctype="multipart/form-data" id="uploadForm">
          <input type="hidden" name="caseId" value="<%= caseDoc._id %>">

          <div class="mb-4">
            <label class="form-label" for="evidenceFiles">Select Digital Crime-Scene Photographs <span class="text-danger">*</span></label>
            <div class="p-4 border border-2 border-dashed rounded bg-light text-center">
              <i class="bi bi-images fs-1 text-primary d-block mb-2"></i>
              <div class="mb-2 fw-semibold text-dark">Click to browse or drag and drop image files</div>
              <input type="file" class="form-control w-75 mx-auto" id="evidenceFiles" name="evidenceFiles" multiple accept="image/jpeg,image/png,image/webp" required>
              <small class="text-muted d-block mt-2">
                Supported formats: <strong>JPG, JPEG, PNG, WebP</strong>. Maximum 10 images per batch, up to 30MB per image.
              </small>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label" for="generalDescription">Evidence Batch Description / Field Notes</label>
            <textarea class="form-control" id="generalDescription" name="generalDescription" rows="3" placeholder="e.g. Crime scene photographs taken in kitchen and living room entry. Evidence markers 1-4 visible."></textarea>
            <small class="text-muted">Initial evidentiary description applied to uploaded items.</small>
          </div>

          <!-- Selected Files Preview Container -->
          <div id="fileListContainer" class="mb-4 d-none">
            <h6 class="text-uppercase text-dark border-bottom pb-2 mb-2 fw-bold" style="font-size: 11px; letter-spacing: 0.5px;">
              Selected Files for Cryptographic Ingestion (<span id="fileCount">0</span>)
            </h6>
            <div class="table-responsive">
              <table class="table table-gov table-sm mb-0">
                <thead>
                  <tr>
                    <th style="width: 50px;">#</th>
                    <th>Filename</th>
                    <th>File Size</th>
                    <th>Specific Item Description</th>
                  </tr>
                </thead>
                <tbody id="previewTableBody">
                  <!-- Populated dynamically via main.js -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Forensic Security Note -->
          <div class="alert alert-light border py-2 px-3 mb-4" style="font-size: 11px; line-height: 1.4;">
            <i class="bi bi-shield-check text-success me-1"></i>
            <strong>Forensic Preservation Assurance:</strong> Uploaded files are stored in a private restricted vault. The server immediately calculates the cryptographic SHA-256 digest on the raw byte stream before creating any thumbnails or analytical overlays.
          </div>

          <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <a href="/cases/<%= caseDoc._id %>" class="btn btn-gov-secondary">
              <i class="bi bi-x-circle me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-gov-primary px-4 py-2" id="submitBtn">
              <i class="bi bi-cloud-arrow-up-fill me-1"></i> Ingest & Calculate SHA-256 Digests
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
