# ==============================================================================
# SMART INVESTIGATION WORKSPACE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# HTTP Application Server Port
PORT=3000

# Central MongoDB Connection URI (Community Server 9.0)
MONGODB_URI=mongodb://127.0.0.1:27017/smart_investigation

# Session Cryptographic Secret Key
SESSION_SECRET=forensic-secure-key-998822334411

# SMTP Credentials for Official Email Verification (Leave blank for Local Dev Mode)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Smart Investigation Workspace" <no-reply@investigation.gov.in>

# Autopsy Digital Forensics Integration & Remote Forensic Worker
# (Optional path to local Autopsy binary, or leave default for embedded ingest engine)
AUTOPSY_PATH=C:\Program Files\Autopsy-4.21.0\bin\autopsy64.exe
AUTOPSY_WORKER_SECRET=forensic-worker-shared-token-2026
AUTOPSY_WORKER_ID=core-forensic-engine

# Private Upload Storage Directory (Local disk cache; files also persistently saved to MongoDB GridFS)
UPLOAD_DIRECTORY=./private_uploads

# Timezone for Authoritative Forensic Displays
TIMEZONE=Asia/Kolkata

# CAPTCHA Secret Salt
CAPTCHA_SECRET=investigation-captcha-salt-2026
