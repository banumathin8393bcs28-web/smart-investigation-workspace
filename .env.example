# HTTP Application Server Port
PORT=3000

# Central MongoDB Connection URI (Community Server 9.0)
MONGODB_URI=mongodb://127.0.0.1:27017/smart_investigation

# Session Cryptographic Secret Key
SESSION_SECRET=forensic-secure-key-998822334411

# SMTP Credentials for Official Email Verification (Leave blank for Local Dev Mode)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Smart Investigation Workspace" <no-reply@investigation.gov.in>

# Local Python Ultralytics YOLOv8 AI Microservice Endpoint
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8000/detect

# Private Upload Storage Directory (Relative or Absolute Path)
UPLOAD_DIRECTORY=./private_uploads

# Timezone for Authoritative Forensic Displays
TIMEZONE=Asia/Kolkata

# CAPTCHA Secret Salt
CAPTCHA_SECRET=investigation-captcha-salt-2026
