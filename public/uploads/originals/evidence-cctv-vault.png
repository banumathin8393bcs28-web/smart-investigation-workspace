<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
    <defs>
      <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#0a0f1d"/>
        <stop offset="100%" stop-color="#152033"/>
      </linearGradient>
    </defs>
    <rect width="800" height="500" fill="url(#g)"/>
    <!-- Viewfinder grid -->
    <rect x="40" y="40" width="720" height="420" fill="none" stroke="#25354e" stroke-dasharray="10,10" stroke-width="2"/>
    <circle cx="400" cy="240" r="140" fill="none" stroke="#38bdf8" stroke-opacity="0.3" stroke-width="2"/>
    <line x1="380" y1="240" x2="420" y2="240" stroke="#38bdf8" stroke-width="2"/>
    <line x1="400" y1="220" x2="400" y2="260" stroke="#38bdf8" stroke-width="2"/>
    <!-- Simulated CCTV Overlay -->
    <text x="60" y="80" fill="#38bdf8" font-family="monospace" font-size="18" font-weight="bold">CAM_04 // REC [●] 1080P</text>
    <text x="60" y="105" fill="#64748b" font-family="monospace" font-size="14">TIME: 2026-10-23T14:32:09.412Z</text>
    <!-- Center subject text -->
    <text x="400" y="245" fill="#38bdf8" font-family="sans-serif" font-size="28" font-weight="bold" text-anchor="middle">COMMERCIAL VAULT CCTV</text>
    <text x="400" y="280" fill="#cbd5e1" font-family="sans-serif" font-size="16" text-anchor="middle">Suspect entering through rear vault breach doorway</text>
